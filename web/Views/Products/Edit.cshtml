@model Solvix.Web.ViewModels.Products.ProductFormViewModel
@{ ViewData["Title"]="Edit product"; var id=ViewData["Id"] as string; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Products</a><h1>Edit product</h1></div></div>
<section class="card form-card"><form asp-action="Edit" asp-route-id="@id" method="post" data-save-form><div asp-validation-summary="All" class="validation-summary"></div><partial name="_ProductFields" model="Model" /><p class="notice">To change existing quantities, use <a asp-controller="Stock" asp-action="Adjust">Stock adjustments</a>.</p><div class="form-actions"><a class="button" asp-action="Index">Cancel</a><button class="button primary" type="submit">Save product</button></div></form></section>
