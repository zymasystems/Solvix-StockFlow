@model Solvix.Web.ViewModels.Products.ProductListViewModel
@inject IAuthorizationService Authorization
@{ ViewData["Title"]="Products"; var isAdmin=(await Authorization.AuthorizeAsync(User,"CompanyAdmin")).Succeeded; }
<div class="page-heading"><div><p class="eyebrow">INVENTORY</p><h1>Products</h1><p class="muted">Manage your catalogue and reorder thresholds.</p></div><a class="button primary" asp-action="Create">+ Add product</a></div>
<section class="card table-card"><div class="table-scroll"><table><caption class="sr-only">Products on this page</caption><thead><tr><th>Product</th><th>SKU</th><th>Category</th><th class="numeric">Unit cost</th><th class="numeric">Stock / min.</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@if(Model.Products.Count==0){<tr><td colspan="7" class="empty-state">No products on this page. Add your first product to get started.</td></tr>}
@foreach(var p in Model.Products){<tr><td><strong>@p.Name</strong></td><td class="mono">@p.Sku</td><td>@p.Category</td><td class="numeric">@p.Price.ToString("N2")</td><td class="numeric">@p.Stock / @p.MinStock</td><td><span class="badge @(p.Stock<=0?"danger":p.Stock<=p.MinStock?"warning":"good")">@p.CalculatedStatus</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@p.Id">Edit</a>@if(isAdmin){<form asp-action="Delete" asp-route-id="@p.Id" method="post" data-confirm="Delete this product? Stock must be zero. History will be retained."><partial name="_CompanyFormFields" /><button type="submit" class="link-button danger-text">Delete</button></form>}</div></td></tr>}
</tbody></table></div><partial name="_Pagination" /></section>
