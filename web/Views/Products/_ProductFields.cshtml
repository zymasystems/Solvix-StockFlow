@model Solvix.Web.ViewModels.Products.ProductFormViewModel
<div class="field"><label asp-for="SupplierId">Supplier</label><select asp-for="SupplierId" asp-items="Model.SupplierOptions"><option value="">No supplier assigned</option></select><span asp-validation-for="SupplierId"></span><small>Suppliers belong to the selected company.</small></div>
<div class="form-grid"><div class="field"><label asp-for="Name">Product name</label><input asp-for="Name" required maxlength="150" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Sku">SKU</label><input asp-for="Sku" required maxlength="50" /><span asp-validation-for="Sku"></span></div>
<div class="field"><label asp-for="Category"></label><select asp-for="Category" asp-items="Model.CategoryOptions" required><option value="">Select a category</option></select><span asp-validation-for="Category"></span></div><div class="field"><label asp-for="Price">Unit price</label><input asp-for="Price" type="number" min="0.01" max="999999999.99" step="0.01" required /><span asp-validation-for="Price"></span></div>
<div class="field"><label asp-for="MinStock">Minimum stock level</label><input asp-for="MinStock" type="number" min="0" max="2147483647" step="1" required /><span asp-validation-for="MinStock"></span><small>Items at or below this level appear on the replenishment list.</small></div></div>
