@model Solvix.Web.ViewModels.Stock.StockAdjustmentCreateViewModel
@{ ViewData["Title"]="Adjust stock"; }
<div class="page-heading"><div><a class="back-link" asp-action="History">← Adjustment history</a><h1>Adjust stock</h1><p class="muted">Submit a stock change for administrator approval. Quantities remain unchanged until approved.</p></div></div>
@if(Model.ProductOptions.Count == 0){<p class="notice">No products are available in this company. Add a product first or check your company selection.</p>}
@inject Solvix.Web.Connected.CompanyMvcContext StockContext
<p class="muted">@StockContext.State?.Company.Name · @StockContext.State?.Warehouses.FirstOrDefault(w => w.Id == StockContext.WarehouseId)?.Name · <a asp-controller="Companies" asp-action="Index">Change warehouse</a></p>
<partial name="_WarehousePicker" model='@("StockAdjust")' />
<section class="card form-card"><form asp-action="Adjust" method="post" data-save-form><input asp-for="RequestId" type="hidden" /><div asp-validation-summary="All" class="validation-summary"></div><div class="field"><label asp-for="ProductId">Product</label><select asp-for="ProductId" asp-items="Model.ProductOptions" required><option value="">Select a product</option></select><span asp-validation-for="ProductId"></span></div>
<div class="form-grid"><div class="field"><label asp-for="Type">Adjustment type</label><select asp-for="Type" data-stock-type><option value="Add">Add stock</option><option value="Subtract">Subtract stock</option><option value="Set">Set exact quantity</option></select><span asp-validation-for="Type"></span></div><div class="field"><label asp-for="Quantity">Quantity</label><input asp-for="Quantity" type="number" min="0" max="2147483647" step="1" required data-stock-quantity /><span asp-validation-for="Quantity"></span></div></div>
<p class="notice" data-stock-help>Choose how the quantity should change.</p><div class="field"><label asp-for="Reason"></label><textarea asp-for="Reason" maxlength="500" required rows="3" placeholder="For example: physical stock count correction"></textarea><span asp-validation-for="Reason"></span></div><div class="form-actions"><a class="button" asp-action="History">Cancel</a><button class="button primary" type="submit">Submit for approval</button></div></form></section>
