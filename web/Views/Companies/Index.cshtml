@model Solvix.Web.Connected.CompanySelectionViewModel
@{ ViewData["Title"] = "Company and warehouse"; }
<div class="page-heading"><div><p class="eyebrow">WORKSPACE</p><h1>Company and warehouse</h1><p class="muted">Each company has its own members, warehouses and inventory.</p></div></div>
<div asp-validation-summary="All" class="validation-summary"></div>
@foreach (var job in Model.PendingDeletions)
{
    <section class="card form-card"><h2>@job.Name</h2><p>Company access is blocked while deletion is being completed.</p><a class="button" asp-action="Delete" asp-route-id="@job.Id">Resume company deletion</a></section>
}
@foreach (var panel in Model.Panels)
{
    <section class="card form-card">
        <h2>@panel.Company.Name</h2>
        <p>@panel.Company.Code · @panel.Role · @panel.Status</p>
        <p class="muted">Company registered: @(panel.Company.CreatedAt?.ToString("dd MMM yyyy") ?? "Not recorded")</p>
        @if (panel.Status == "Active")
        {
            <form asp-action="Select" method="post">
                <input type="hidden" name="companyId" value="@panel.Company.Id" />
                <div class="field"><label>Warehouse<select name="warehouseId">
                @foreach (var warehouse in panel.Warehouses)
                { <option value="@warehouse.Id" selected="@(warehouse.Id == (Model.State?.Company.Id == panel.Company.Id ? Model.WarehouseId : panel.Company.DefaultWarehouseId))">@warehouse.Name</option> }
                </select></label></div>
                <button class="button primary" type="submit">Open company</button>
            </form>
        }
        @if (panel.CanManage)
        {
            <details>
                <summary>Members and roles (@panel.Members.Count)</summary>
                @foreach (var member in panel.Members.OrderBy(m => m.FullName))
                {
                    <form asp-action="ReviewMember" method="post">
                        <input type="hidden" name="companyId" value="@panel.Company.Id" />
                        <input type="hidden" name="uid" value="@member.Id" />
                        <input type="hidden" name="requestId" value="@Guid.NewGuid()" />
                        <h3>@member.FullName</h3><p>@member.Email · @member.Code</p>
                        <p class="muted">Registered: @(member.RegisteredAt?.ToString("dd MMM yyyy") ?? "Not recorded") · Joined company: @(member.JoinedAt?.ToString("dd MMM yyyy") ?? "Not recorded")</p>
                        <div class="form-grid">
                            <div class="field"><label>Company role<select name="role"><option value="staff" selected="@(member.Role == "staff")">Staff</option><option value="admin" selected="@(member.Role == "admin")">Company administrator</option></select></label></div>
                            <div class="field"><label>Membership status<select name="status"><option selected="@(member.Status == "Pending")">Pending</option><option selected="@(member.Status == "Active")">Active</option><option selected="@(member.Status == "Inactive")">Inactive</option></select></label></div>
                        </div>
                        <fieldset><legend>Assigned warehouses in @panel.Company.Name</legend>
                        @foreach (var warehouse in panel.Warehouses)
                        { <label><input type="checkbox" name="warehouseIds" value="@warehouse.Id" checked="@member.WarehouseIds.Contains(warehouse.Id)" /> @warehouse.Name</label> }
                        </fieldset>
                        <p class="muted">Company administrators can access every warehouse in this company. Assignments limit staff access.</p>
                        <button class="button" type="submit">Save membership</button>
                    </form>
                }
            </details>
            <details>
                <summary>Company settings and warehouses</summary>
                <form asp-action="Rename" method="post">
                    <input type="hidden" name="companyId" value="@panel.Company.Id" /><input type="hidden" name="requestId" value="@Guid.NewGuid()" />
                    <div class="field"><label>Company name<input name="name" value="@panel.Company.Name" required maxlength="200" /></label></div>
                    <button class="button" type="submit">Save company name</button>
                </form>
                <form asp-action="AddWarehouse" method="post">
                    <input type="hidden" name="companyId" value="@panel.Company.Id" /><input type="hidden" name="requestId" value="@Guid.NewGuid()" />
                    <div class="field"><label>New warehouse name<input name="name" required maxlength="200" /></label></div>
                    <button class="button primary" type="submit">Add warehouse</button>
                </form>
            </details>
        }
        @if (panel.CanDelete)
        {
            <div class="company-delete-actions">
                <a class="button danger" asp-action="Delete" asp-route-id="@panel.Company.Id" aria-label="Delete @panel.Company.Name">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6" /></svg>
                    Delete company
                </a>
            </div>
        }
    </section>
}
@if (Model.Panels.Count == 0) { <section class="card form-card"><p>No company membership yet. Enter your company below.</p></section> }
<section class="card form-card"><h2>Find or create your company</h2><p>Existing names request membership in that company. A new company receives a main warehouse automatically. Matching ignores letter case and repeated spaces.</p><form asp-action="Create" method="post"><input type="hidden" name="requestId" value="@Guid.NewGuid()" /><div class="field"><label for="company-name">Company name</label><input id="company-name" name="name" required maxlength="200" /></div><button type="submit" class="button primary">Continue with company</button></form></section>
