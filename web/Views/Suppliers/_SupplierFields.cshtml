@model Solvix.Web.ViewModels.Suppliers.SupplierFormViewModel
<div class="form-grid"><div class="field"><label asp-for="Name">Supplier name</label><input asp-for="Name" required maxlength="150" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="ContactPerson">Contact person</label><input asp-for="ContactPerson" required maxlength="100" /><span asp-validation-for="ContactPerson"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" required maxlength="254" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" required maxlength="30" /><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="Status"></label><select asp-for="Status"><option>Active</option><option>Inactive</option></select><span asp-validation-for="Status"></span></div><div class="field"><label asp-for="Rating">Rating (0–5)</label><input asp-for="Rating" type="number" min="0" max="5" step="0.1" required /><span asp-validation-for="Rating"></span></div></div>
