@model Solvix.Web.ViewModels.Users.UserEditViewModel
@{ ViewData["Title"]="Edit user"; var id=ViewData["Id"] as string; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Manage users</a><h1>Review user access</h1><p class="muted">Choose the role and status appropriate for this team member.</p></div></div>
<section class="card form-card"><form asp-action="Edit" asp-route-id="@id" method="post" data-save-form><div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="FirstName">First name</label><input asp-for="FirstName" required maxlength="100" /><span asp-validation-for="FirstName"></span></div><div class="field"><label asp-for="LastName">Last name</label><input asp-for="LastName" required maxlength="100" /><span asp-validation-for="LastName"></span></div><div class="field"><label asp-for="Company"></label><input asp-for="Company" maxlength="150" list="registered-companies" /><datalist id="registered-companies">@foreach (var companyName in ViewData["CompanyNames"] as List<string> ?? new List<string>()) { <option value="@companyName"></option> }</datalist><span asp-validation-for="Company"></span></div><div class="field"><label asp-for="Role">System role</label><select asp-for="Role"><option value="staff">Staff</option><option value="admin">Administrator</option></select><span asp-validation-for="Role"></span></div><div class="field"><label asp-for="CompanyRole">Role in this company</label><select asp-for="CompanyRole"><option value="staff">Staff</option><option value="admin">Company administrator</option></select><span asp-validation-for="CompanyRole"></span></div><div class="field"><label asp-for="Status"></label><select asp-for="Status"><option value="Inactive">Inactive / awaiting approval</option><option value="Active">Active</option></select><span asp-validation-for="Status"></span></div></div><p class="notice">Activating this profile links the person to the named company and its default warehouse. Existing companies are reused. A company role applies only inside that company; the system administrator role manages account approvals. Inactive accounts cannot use inventory.</p><div class="form-actions"><a class="button" asp-action="Index">Cancel</a><button class="button primary" type="submit">Save access settings</button></div></form></section>
