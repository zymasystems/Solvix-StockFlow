@model Solvix.Web.ViewModels.Sales.SaleCreateViewModel
@{ ViewData["Title"]="Record movement"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Sales & stock out</a><h1>Record a stock movement</h1><p class="muted">Sales and returns are submitted for verification and approval before stock changes.</p></div></div>
<section class="card form-card"><form asp-action="Create" method="post" data-save-form><partial name="_CompanyFormFields" /><input asp-for="RequestId" type="hidden" /><div asp-validation-summary="All" class="validation-summary"></div>
<div class="field"><label asp-for="ProductId">Product</label><select asp-for="ProductId" asp-items="Model.ProductOptions" required><option value="">Select a product</option></select><span asp-validation-for="ProductId"></span></div>
<div class="form-grid"><div class="field"><label asp-for="Type">Movement type</label><select asp-for="Type"><option value="Sale">Sale</option><option value="Return">Return</option><option value="Transfer">Transfer out</option></select><span asp-validation-for="Type"></span></div><div class="field"><label asp-for="Quantity"></label><input asp-for="Quantity" type="number" min="1" max="2147483647" step="1" required /><span asp-validation-for="Quantity"></span></div></div>
<div class="field"><label asp-for="DestinationWarehouseId">Destination warehouse (transfers only)</label><select asp-for="DestinationWarehouseId" asp-items="Model.WarehouseOptions"><option value="">Select destination for a transfer</option></select><span asp-validation-for="DestinationWarehouseId"></span></div>
<div class="field"><label asp-for="Notes"></label><textarea asp-for="Notes" maxlength="1000" rows="3"></textarea><span asp-validation-for="Notes"></span></div><p class="notice">Select a destination for transfers. Source and destination stock change only after their required approvals.</p><div class="form-actions"><a class="button" asp-action="Index">Cancel</a><button class="button primary" type="submit">Record movement</button></div></form></section>
