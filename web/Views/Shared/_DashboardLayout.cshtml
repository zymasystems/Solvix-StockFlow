<!DOCTYPE html>
<html lang="en">
<head>
    <base href="~/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Solvix StockFlow</title>
    <link rel="stylesheet" href="~/css/landing-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="app-shell">
<a class="skip-link" href="#main">Skip to content</a>
<aside class="sidebar" id="sidebar"><partial name="_Sidebar" /></aside>
<div class="app-body">
    <header class="app-topbar">
        <button type="button" class="button mobile-menu" data-menu-toggle aria-controls="sidebar" aria-expanded="false">Menu</button>
        <span class="eyebrow">WORKSPACE / @ViewContext.RouteData.Values["controller"]</span>
        <div class="topbar-actions"><a asp-controller="Dashboard" asp-action="Index">Overview</a><partial name="_LogoutForm" /></div>
    </header>
    <main class="page-content" id="main">
        @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
        @if (ViewData["CompanyContextId"] is not null)
        {
            <partial name="_CompanySelectionSummary" />
        }
        @RenderBody()
    </main>
    <partial name="_Footer" />
</div>
<partial name="_FirebaseConfig" />
<script type="module" src="~/js/dashboard.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
