@model Solvix.Web.ViewModels.Dashboard.DashboardViewModel
<div class="page-heading"><div><p class="eyebrow">YOUR INVENTORY AT A GLANCE</p><h1>Welcome, @Model.UserDisplayName</h1><p class="muted">A snapshot of your stock and recent recorded activity.</p></div><a class="button primary" asp-controller="Sales" asp-action="Create">Record a sale</a></div>
<div class="stats-grid"><article class="stat card"><p>Products</p><strong>@Model.TotalProducts.ToString("N0")</strong><small>@Model.TotalUnits.ToString("N0") units on hand</small></article><article class="stat card"><p>Inventory value</p><strong>@Model.InventoryValue.ToString("N2")</strong><small>Based on current unit prices</small></article><article class="stat card"><p>Low stock</p><strong>@Model.LowStockCount.ToString("N0")</strong><small>Available but below threshold</small></article><article class="stat card"><p>Out of stock</p><strong>@Model.OutOfStockCount.ToString("N0")</strong><small>Items needing replenishment</small></article></div>
<div class="two-columns"><section class="card"><div class="section-heading"><h2>Stock by category</h2><a asp-controller="Products" asp-action="Index">View products →</a></div>
@if(Model.Categories.Count==0){<p class="empty-state">Add products to see category totals.</p>}else{
    var maxUnits = Math.Max(1L, Model.Categories.Max(x=>x.StockUnits));
    foreach(var category in Model.Categories){var width=(100m*category.StockUnits/maxUnits).ToString("0.##",CultureInfo.InvariantCulture);<div class="category-row"><div><strong>@category.Category</strong><span>@category.StockUnits.ToString("N0") units · @category.ProductCount products</span></div><div class="bar-track"><div class="bar-fill" style="width: @(width)%"></div></div></div>}
}
</section><section class="card"><div class="section-heading"><h2>Replenishment watch</h2><a asp-controller="Stock" asp-action="Adjust">Adjust stock →</a></div>
@if(Model.LowStockProducts.Count==0){<p class="empty-state">No items on the current low-stock list.</p>}else{<ul class="plain-list">@foreach(var p in Model.LowStockProducts){<li><div><strong>@p.Name</strong><small>@p.Sku · Minimum @p.MinStock</small></div><span class="badge @(p.Stock<=0?"danger":"warning")">@p.Stock on hand</span></li>}</ul>}
</section></div>
<section class="card"><div class="section-heading"><h2>Recent stock activity</h2><a asp-controller="Stock" asp-action="History">Full history →</a></div><div class="two-columns flush"><div><h3>Sales & returns</h3>@if(Model.RecentSales.Count==0){<p class="empty-state">No dated sales activity to display.</p>}else{<ul class="plain-list">@foreach(var sale in Model.RecentSales){<li><div><strong>@sale.ProductName</strong><small>@sale.Type · @sale.PerformedByName</small></div><span>@sale.Quantity units</span></li>}</ul>}</div><div><h3>Adjustments</h3>@if(Model.RecentAdjustments.Count==0){<p class="empty-state">No dated adjustments to display.</p>}else{<ul class="plain-list">@foreach(var entry in Model.RecentAdjustments){<li><div><strong>@entry.ProductName</strong><small>@entry.Reason</small></div><span class="badge">@entry.Change</span></li>}</ul>}</div></div><p class="muted small-text">Older records without a confirmed timestamp are available in history but excluded from recent activity.</p></section>
