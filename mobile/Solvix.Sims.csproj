<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- Android only to keep this lean. Add ios / maccatalyst / windows TFMs later (see README). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Solvix.Sims</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<!-- Keep the BlazorWebView's reflection-based static asset resolver intact in Release builds. -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>

		<ApplicationTitle>Solvix SIMS</ApplicationTitle>
		<ApplicationId>co.za.zyma.solvixsims</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- Keep Visual Studio design-time icon output separate from the deployable build. -->
		<_ResizetizerIntermediateOutputPath Condition="'$(DesignTimeBuild)' == 'true'">$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\resizetizer-design-time\</_ResizetizerIntermediateOutputPath>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
                <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" />
		<MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#0A4269" BaseSize="256,256" />
	</ItemGroup>

	<!-- Keep the Tailwind build tooling out of the .NET build -->
	<ItemGroup>
		<Compile Remove="tools/**" />
		<Content Remove="tools/**" />
		<None Remove="tools/**" />
		<EmbeddedResource Remove="tools/**" />
	</ItemGroup>

</Project>
