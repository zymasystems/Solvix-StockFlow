@* Square product tile: shows a photo if Product.ImageUrl is set, otherwise a Material icon. *@
<div class="@Class rounded-lg bg-surface-container-low flex items-center justify-center shrink-0 overflow-hidden shadow-inner relative">
    @if (!string.IsNullOrEmpty(Product.ImageUrl))
    {
        <img src="@Product.ImageUrl" alt="@Product.Name" class="w-full h-full object-cover" />
    }
    else
    {
        <span class="material-symbols-outlined text-primary" style="font-size: 50%">@Product.Icon</span>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "w-12 h-12";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
