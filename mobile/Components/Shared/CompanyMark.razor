@if (!string.IsNullOrWhiteSpace(Company.LogoUrl))
{
    <img src="@Company.LogoUrl" alt="@Company.Name" class="@Class object-contain" />
}
else
{
    <div class="@Class company-mark bg-gradient-to-br @Company.ThemeColor" aria-label="@Company.Name"><span class="material-symbols-outlined">@Company.Icon</span></div>
}

@code {
    [Parameter, EditorRequired] public Company Company { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "h-9 w-9";
}
