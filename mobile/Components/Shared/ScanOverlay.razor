@* Full-screen scanner sheet. Currently simulated. See README for wiring a real camera scanner. *@
@if (Visible)
{
    <div class="fixed inset-0 z-[60] bg-inverse-surface/80 backdrop-blur-md flex flex-col justify-between p-space-lg pt-[calc(1.5rem+env(safe-area-inset-top,0px))]">
        <div class="flex items-center justify-between text-on-primary">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px] text-primary-fixed">barcode_scanner</span>
                <span class="font-label-lg text-label-lg">Solvix Optical Scanner</span>
            </div>
            <button aria-label="Close scanner" @onclick="Close" class="w-10 h-10 rounded-full bg-surface/20 flex items-center justify-center text-on-primary">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <div class="relative w-64 h-64 mx-auto my-auto rounded-2xl flex items-center justify-center">
            <div class="absolute inset-0 bg-primary/10 rounded-2xl"></div>
            <div class="w-56 h-0.5 bg-primary-fixed animate-pulse shadow-[0_0_12px_#73f8df]"></div>
            <span class="absolute bottom-4 font-label-sm text-label-sm text-inverse-on-surface">Align barcode in frame</span>
        </div>

        <div class="flex flex-col gap-2">
            <button @onclick="SimulateAsync" disabled="@busy"
                    class="w-full py-3 rounded-lg bg-primary text-on-primary font-label-md text-label-md active:scale-95 transition-all flex items-center justify-center gap-2">
                @if (done)
                {
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    <span>Verified @SimulatedSku</span>
                }
                else if (busy)
                {
                    <span class="material-symbols-outlined text-[18px] animate-spin">refresh</span>
                    <span>Processing...</span>
                }
                else
                {
                    <span class="material-symbols-outlined text-[18px]">document_scanner</span>
                    <span>Simulate Scan (@SimulatedSku)</span>
                }
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string SimulatedSku { get; set; } = "SVX-SRV-2401";
    [Parameter] public EventCallback<string> OnScanned { get; set; }

    bool busy, done;

    async Task Close()
    {
        Visible = false;
        busy = done = false;
        await VisibleChanged.InvokeAsync(false);
    }

    async Task SimulateAsync()
    {
        busy = true;
        await Task.Delay(700);
        busy = false;
        done = true;
        StateHasChanged();
        await Task.Delay(600);
        var sku = SimulatedSku;
        await Close();
        await OnScanned.InvokeAsync(sku);
    }
}
