@using Solvix.Sims.Services.Authentication
@implements IDisposable
@inject MobileAuthCoordinator Auth
@inject NavigationManager Nav

@if (IsPublic)
{
    @ChildContent
}
else if (loading)
{
    <p class="p-6" role="status">Checking your session...</p>
}
else if (Auth.IsApproved)
{
    @ChildContent
}
else
{
    <main class="p-6"><p role="alert">@(error ?? "Sign in with an approved account to continue.")</p>
        <a href="/login" class="text-primary underline">Sign in</a>
        <button type="button" @onclick="CheckAsync">Retry connection</button>
    </main>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    bool loading = true;
    string? error;
    bool IsPublic => new[] { "", "login", "register", "welcome", "onboarding" }
        .Contains(Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/'), StringComparer.OrdinalIgnoreCase);
    protected override void OnInitialized() => Auth.Changed += Changed;
    protected override async Task OnParametersSetAsync()
    {
        if (!IsPublic) await CheckAsync();
    }
    async Task CheckAsync()
    {
        error = null; loading = true;
        try { await Auth.InitializeAsync(); }
        catch (Exception exception) { error = AuthMessages.Describe(exception); }
        finally { loading = false; }
    }
    void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= Changed;
}
