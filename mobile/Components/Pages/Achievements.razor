@page "/achievements"
@layout TabLayout
@implements IDisposable
@inject InventoryService Inventory

<div class="page-stack">
    <section class="achievement-hero">
        <div><span class="eyebrow eyebrow-light">COMPANY PROGRESS</span><h1>Keep your inventory in motion.</h1><p>Small daily actions help your team keep stock accurate and ready.</p></div>
        <div class="xp-medallion"><span class="material-symbols-outlined">military_tech</span><b>LV @Level</b><small>@Xp XP</small></div>
        <div class="xp-track"><span style="width:@LevelProgress%"></span></div>
        <div class="xp-caption"><span>Level @Level</span><span>@XpToNext XP to level @(Level + 1)</span></div>
    </section>

    <div class="achievement-stats">
        <article><span class="stat-icon streak"><span class="material-symbols-outlined">local_fire_department</span></span><b>@Streak day@(Streak == 1 ? "" : "s")</b><small>active streak</small></article>
        <article><span class="stat-icon check"><span class="material-symbols-outlined">task_alt</span></span><b>@WeeklyActions / 10</b><small>weekly actions</small></article>
        <article><span class="stat-icon badge"><span class="material-symbols-outlined">workspace_premium</span></span><b>@EarnedBadges / @Badges.Count</b><small>milestones earned</small></article>
    </div>

    <section class="settings-card">
        <div class="section-heading-row"><div><span class="eyebrow">THIS WEEK</span><h2>Team missions</h2><p>Useful tasks that build good inventory habits.</p></div><span class="material-symbols-outlined">flag</span></div>
        @foreach (var mission in Missions)
        {
            <div class="mission-row"><div class="mission-icon"><span class="material-symbols-outlined">@mission.Icon</span></div><div class="mission-copy"><b>@mission.Title</b><small>@mission.Description</small><div class="mission-track"><span style="width:@mission.Percent%"></span></div></div><div class="mission-reward">+@mission.Reward XP</div></div>
        }
    </section>

    <section class="settings-card">
        <div class="section-heading-row"><div><span class="eyebrow">RECOGNITION</span><h2>Milestone badges</h2><p>Earned through real work in this company workspace.</p></div><span class="material-symbols-outlined">workspace_premium</span></div>
        <div class="badge-grid">
            @foreach (var badge in Badges)
            {
                <article class="badge-card @(badge.Earned ? "earned" : "locked")"><div><span class="material-symbols-outlined">@(badge.Earned ? badge.Icon : "lock")</span></div><b>@badge.Title</b><small>@badge.Description</small>@if (badge.Earned) { <span class="badge-earned">Earned</span> }
            </article>
            }
        </div>
    </section>
    <p class="achievement-footnote">Progress is based on activity in @Inventory.CurrentCompany.Name and stays within this company workspace.</p>
</div>

@code {
    record Mission(string Title, string Description, string Icon, int Progress, int Target, int Reward) { public int Percent => Math.Min(100, Progress * 100 / Target); }
    record Badge(string Title, string Description, string Icon, bool Earned);
    int Xp => Inventory.Products.Count * 25 + Inventory.Movements.Count(m => m.CompanyId == Inventory.CurrentCompanyId) * 10;
    int Level => Xp / 250 + 1;
    int XpToNext => 250 - Xp % 250;
    int LevelProgress => Xp % 250 * 100 / 250;
    int WeeklyActions => Inventory.Movements.Count(m => m.CompanyId == Inventory.CurrentCompanyId && m.At >= DateTime.Now.AddDays(-7));
    int Streak
    {
        get
        {
            var days = Inventory.Movements.Where(m => m.CompanyId == Inventory.CurrentCompanyId).Select(m => m.At.Date).Distinct().ToHashSet();
            var cursor = DateTime.Today;
            if (!days.Contains(cursor)) cursor = cursor.AddDays(-1);
            var count = 0;
            while (days.Contains(cursor)) { count++; cursor = cursor.AddDays(-1); }
            return count;
        }
    }
    List<Mission> Missions => new()
    {
        new("Keep the ledger moving", "Record 10 stock actions this week", "swap_vert", WeeklyActions, 10, 100),
        new("Build a reliable catalog", "Add products to your company catalog", "inventory_2", Inventory.Products.Count, 10, 150),
        new("Cover every location", "Set up at least 3 warehouses", "warehouse", Inventory.CurrentCompany.Warehouses.Count, 3, 120)
    };
    List<Badge> Badges => new()
    {
        new("First steps", "Record your first inventory action", "footprint", Inventory.Movements.Any(m => m.CompanyId == Inventory.CurrentCompanyId)),
        new("Catalog builder", "Add 10 products to the catalog", "inventory_2", Inventory.Products.Count >= 10),
        new("Multi-site", "Manage stock across 3 warehouses", "warehouse", Inventory.CurrentCompany.Warehouses.Count >= 3),
        new("Steady hands", "Record 10 stock actions", "verified", WeeklyActions >= 10),
        new("Dispatch ready", "Complete a dispatch order", "local_shipping", Inventory.Movements.Any(m => m.CompanyId == Inventory.CurrentCompanyId && m.Title.Contains("ORD", StringComparison.OrdinalIgnoreCase)))
    };
    int EarnedBadges => Badges.Count(b => b.Earned);
    protected override void OnInitialized() => Inventory.Changed += OnChanged;
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Inventory.Changed -= OnChanged;
}
