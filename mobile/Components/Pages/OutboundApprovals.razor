@inherits Solvix.Sims.Services.ConnectedComponent
@page "/dispatch/approvals"
@layout StackLayout
@implements IDisposable
@inject InventoryService Inventory
@inject NavigationManager Nav

<div class="approval-page">
    <section class="approval-hero outbound-approval-hero">
        <a href="/operations" class="approval-back-link"><span class="material-symbols-outlined">arrow_back</span>Operations</a>
        <div class="approval-hero-row"><div class="approval-hero-icon"><span class="material-symbols-outlined">local_shipping</span></div><div><span class="workflow-eyebrow">DISPATCH CONTROL · @Inventory.CurrentWarehouse</span><h1>Approve staged dispatches</h1><p>Review scanned loads. Approval creates a separate outbound for verification.</p></div></div>
        <div class="approval-hero-count"><b>@Requests.Count(x => x.StagedStatus == StagedDispatchStatus.Pending)</b><span>waiting for dispatch approval</span></div>
    </section>

    @if (!Requests.Any())
    {
        <section class="approval-empty"><span class="material-symbols-outlined">task_alt</span><h2>No staged dispatches yet</h2><p>Create a dispatch, verify its products in the manifest, and it will appear here for approval.</p><a href="/dispatch/new" class="workflow-primary-button">Create dispatch</a></section>
    }
    else
    {
        @foreach (var request in Requests.OrderBy(x => x.StagedStatus == StagedDispatchStatus.Pending ? 0 : 1).ThenByDescending(x => x.CreatedAt))
        {
            <article class="approval-request-card">
                <div class="approval-request-top"><div><span class="approval-reference">@request.WorkOrder</span><span class="approval-status @request.ApprovalStatus.ToString().ToLowerInvariant()">@request.ApprovalStatus</span></div><small>@request.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small></div>
                <h2>@request.Destination</h2>
                <p class="approval-subtitle">From @request.SourceWarehouse → @request.Destination · @request.Handler</p>
                <div class="approval-request-stats"><div><span>Items verified</span><b>@request.VerifiedLines / @request.Lines.Count SKU(s)</b></div><div><span>Total quantity</span><b>@request.TotalUnits units</b></div><div><span>Handler</span><b>@request.Handler</b></div></div>
                @if (!string.IsNullOrWhiteSpace(request.Note)) { <p class="approval-note">@request.Note</p> }
                @if (request.StagedStatus == StagedDispatchStatus.Pending)
                {
                    <div class="approval-buttons"><button type="button" class="approval-reject" @onclick="() => Reject(request)"><span class="material-symbols-outlined">close</span>Reject</button><button type="button" class="approval-accept" @onclick="() => Approve(request)"><span class="material-symbols-outlined">check</span>Approve &amp; create outbound</button></div>
                }
                else if (request.ApprovalStatus == ApprovalStatus.Approved)
                {
                    <a href="/outbound/approvals" class="approval-open-link"><span class="material-symbols-outlined">qr_code_scanner</span>Open outbound verification</a>
                }
                else if (request.ApprovalStatus == ApprovalStatus.Rejected)
                {
                    <a class="approval-open-link" href="@($"/dispatch/new?warehouse={Uri.EscapeDataString(request.SourceWarehouse)}")"><span class="material-symbols-outlined">replay</span>Create replacement dispatch</a>
                }
                @if (request.ReviewedAt is not null) { <small class="approval-review-date">Reviewed @request.ReviewedAt.Value.ToString("dd MMM yyyy, HH:mm") @if (!string.IsNullOrWhiteSpace(request.ReviewNote)) { <span>· @request.ReviewNote</span> }</small> }
            </article>
        }
    }
</div>

@code {
    IEnumerable<DispatchOrder> Requests => Inventory.DispatchRequests.Where(x => x.CompanyId == Inventory.CurrentCompanyId && x.SourceWarehouse == Inventory.CurrentWarehouse && x.StagedStatus != StagedDispatchStatus.NotStaged);

    protected override void OnInitialized() => Inventory.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    async Task Approve(DispatchOrder request)
    {
        if (await Inventory.ReviewDispatchAsync(request.Id, true)) Nav.NavigateTo("/outbound/approvals");
    }
    async Task Reject(DispatchOrder request) { await Inventory.ReviewDispatchAsync(request.Id, false, "Rejected from outbound approvals."); }
    public void Dispose() => Inventory.Changed -= Refresh;
}
