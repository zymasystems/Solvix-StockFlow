@page "/outbound/approvals"
@layout StackLayout
@implements IDisposable
@inject InventoryService Inventory

<div class="approval-page staged-dispatch-page">
    <section class="approval-hero outbound-approval-hero">
        <a href="/operations" class="approval-back-link"><span class="material-symbols-outlined">arrow_back</span>Operations</a>
        <div class="approval-hero-row"><div class="approval-hero-icon"><span class="material-symbols-outlined">outbox</span></div><div><span class="workflow-eyebrow">OUTBOUND CONTROL</span><h1>Verify &amp; approve outbounds</h1><p>Dispatch approval creates an outbound record. Verify each SKU, then approve its release.</p></div></div>
        <div class="approval-hero-count"><b>@Pending.Count()</b><span>outbounds awaiting verification and approval</span></div>
    </section>

    @if (!Requests.Any())
    {
        <section class="approval-empty"><span class="material-symbols-outlined">outbox</span><h2>No outbound records yet</h2><p>Approve a staged dispatch first. Its outbound record will appear here for a second verification and final approval.</p><a href="/dispatch/approvals" class="workflow-primary-button">Review staged dispatches</a></section>
    }
    else
    {
        @foreach (var request in Requests.OrderBy(x => x.ApprovalStatus == ApprovalStatus.Pending ? 0 : 1).ThenByDescending(x => x.CreatedAt))
        {
            <article class="approval-request-card staged-dispatch-card">
                <div class="approval-request-top"><div><span class="approval-reference">Outbound · @request.WorkOrder</span><span class="approval-status @request.ApprovalStatus.ToString().ToLowerInvariant()">@request.ApprovalStatus</span></div><small>@request.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small></div>
                <h2>@request.Destination</h2>
                <p class="approval-subtitle">From @request.SourceWarehouse · Handler: @request.Handler</p>
                <div class="staged-dispatch-summary"><div><span class="material-symbols-outlined">inventory_2</span><b>@request.Lines.Count</b><small>SKUs</small></div><div><span class="material-symbols-outlined">shopping_bag</span><b>@request.TotalUnits</b><small>units</small></div><div><span class="material-symbols-outlined">check_circle</span><b>@request.Lines.Count(x => x.Verified) / @request.Lines.Count</b><small>verified</small></div></div>
                <div class="staged-line-list">
                    @foreach (var line in request.Lines)
                    {
                        <div class="staged-line"><span class="material-symbols-outlined">@line.Icon</span><div><b>@line.Name</b><small>@line.Sku · Bin @line.Bin</small></div><strong>@line.Qty <small>units</small></strong>@if (request.ApprovalStatus == ApprovalStatus.Pending) { <button type="button" class="outbound-scan-button" @onclick="() => Scan(request, line)"><span class="material-symbols-outlined">@(line.Verified ? "check_circle" : "barcode_scanner")</span>@(line.Verified ? "Verified" : "Verify")</button> }</div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(request.Reference)) { <p class="approval-note">Reference: @request.Reference</p> }
                @if (request.ApprovalStatus == ApprovalStatus.Pending)
                {
                    <p class="staged-release-hint"><span class="material-symbols-outlined">info</span>Every SKU must be barcode verified before final approval. Stock only leaves this warehouse after approval.</p>
                    <div class="approval-buttons"><button type="button" class="approval-reject" @onclick="() => Reject(request)"><span class="material-symbols-outlined">close</span>Reject outbound</button><button type="button" class="approval-accept" disabled="@(!request.AllVerified)" @onclick="() => Approve(request)"><span class="material-symbols-outlined">local_shipping</span>Approve &amp; dispatch</button></div>
                }
                else if (request.ReviewedAt is not null)
                {
                    <small class="approval-review-date">Reviewed @request.ReviewedAt.Value.ToString("dd MMM yyyy, HH:mm") @if (!string.IsNullOrWhiteSpace(request.ReviewNote)) { <span>· @request.ReviewNote</span> }</small>
                    @if (request.ApprovalStatus == ApprovalStatus.Approved && !string.IsNullOrWhiteSpace(request.DestinationWarehouse)) { <small class="approval-review-date">Transfer generated inbound receipt(s) for @request.DestinationWarehouse.</small><a class="approval-open-link" href="@($"/receiving/approvals?warehouse={Uri.EscapeDataString(request.DestinationWarehouse)}")"><span class="material-symbols-outlined">move_to_inbox</span>Review receipts at @request.DestinationWarehouse</a> }
                }
            </article>
        }
    }
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="staged-dispatch-message"><span class="material-symbols-outlined">@(isError ? "error" : "check_circle")</span>@message</div> }
</div>

<BarcodeScanner @bind-Visible="scannerOpen" OnDetected="OnBarcode" />

@code {
    IEnumerable<OutboundOrder> Requests => Inventory.OutboundRequests.Where(x => x.CompanyId == Inventory.CurrentCompanyId && x.SourceWarehouse == Inventory.CurrentWarehouse);
    IEnumerable<OutboundOrder> Pending => Requests.Where(x => x.ApprovalStatus == ApprovalStatus.Pending);
    bool scannerOpen, isError;
    string message = "", scanRequestId = "", scanSku = "";

    protected override void OnInitialized() => Inventory.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    void Scan(OutboundOrder request, DispatchLine line) { scanRequestId = request.Id; scanSku = line.Sku; scannerOpen = true; }
    void OnBarcode(string code)
    {
        isError = !Inventory.VerifyOutboundItem(scanRequestId, code, scanSku);
        message = isError ? $"Barcode {code} does not match {scanSku}." : $"Verified {scanSku}.";
    }
    void Approve(OutboundOrder request)
    {
        isError = !Inventory.ReviewOutbound(request.Id, true);
        message = isError ? $"Could not approve {request.WorkOrder}. Recheck stock availability." : string.IsNullOrWhiteSpace(request.DestinationWarehouse) ? $"{request.WorkOrder} dispatched. Warehouse stock updated." : $"{request.WorkOrder} sent to receiving at {request.DestinationWarehouse}.";
    }
    void Reject(OutboundOrder request)
    {
        isError = !Inventory.ReviewOutbound(request.Id, false, "Rejected from outbound verification.");
        message = isError ? "Could not reject this outbound. Refresh and try again." : "Outbound rejected. Source warehouse stock was not changed.";
    }
    public void Dispose() => Inventory.Changed -= Refresh;
}
