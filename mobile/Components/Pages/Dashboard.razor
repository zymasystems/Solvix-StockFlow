@inherits Solvix.Sims.Services.ConnectedComponent
@page "/dashboard"
@layout TabLayout
@implements IDisposable
@inject InventoryService Inventory
@inject SessionState Session
@inject NavigationManager Nav

<div class="flex flex-col w-full gap-space-md">

    <!-- Greeting + Company Context card -->
    <section class="bg-surface-container-low rounded-xl p-space-md shadow-sm relative overflow-hidden">
        <div class="absolute -right-8 -top-8 w-36 h-36 rounded-full bg-gradient-to-br @Inventory.CurrentCompany.ThemeColor opacity-20 pointer-events-none blur-xl"></div>
        <div class="flex items-start justify-between relative z-10 gap-space-sm">
            <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-space-xs mb-1 flex-wrap">
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-label-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                        <span class="font-bold text-on-surface">@Inventory.CurrentCompany.Code</span>
                        <span>•</span>
                        <span class="truncate max-w-[140px]">@Session.HubName</span>
                    </div>
                    <span class="text-on-surface-variant font-label-sm text-label-sm">Shift A</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight font-bold">@Session.Greeting, @Session.FirstName</h1>
                <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5 truncate">
                    <span class="material-symbols-outlined text-[15px] text-primary">verified_user</span>
                    <span>@Inventory.CurrentCompany.Name • @Session.Email</span>
                </p>
            </div>
            <button aria-label="Scan barcode directly" @onclick="() => scanning = true"
                    class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br @Inventory.CurrentCompany.ThemeColor text-white flex items-center justify-center shadow-md active:scale-95 transition-all">
                <span class="material-symbols-outlined text-[24px]">qr_code_scanner</span>
            </button>
        </div>
        <div class="mt-3 pt-2.5 border-t border-surface-container-highest/60 flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm">
            <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px] text-primary">schedule</span> Synced live
            </span>
            <span class="font-label-sm text-label-sm text-on-surface-variant font-medium">
                @Inventory.CurrentCompany.Industry
            </span>
        </div>
    </section>

    <!-- KPI grid -->
    <section class="grid grid-cols-2 gap-space-sm">
        <a href="/inventory" class="bg-surface-container-lowest p-space-sm rounded-xl shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                </div>
                <span class="font-label-sm text-label-sm text-primary font-semibold flex items-center">
                    Catalog <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                </span>
            </div>
            <div class="mt-2">
                <span class="font-metric-num text-metric-num text-on-surface block">@Inventory.WarehouseSkuCount</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">SKUs at this warehouse</span>
            </div>
        </a>

        <div class="bg-surface-container-lowest p-space-sm rounded-xl shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center text-amber-700">
                    <span class="material-symbols-outlined text-[18px]">warning</span>
                </div>
                <span class="px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800 font-label-sm text-label-sm font-semibold flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Alert
                </span>
            </div>
            <div class="mt-2">
                <span class="font-metric-num text-metric-num text-amber-900 block">@Inventory.WarehouseLowStockCount items</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">Below Buffer</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-space-sm rounded-xl shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <div class="w-8 h-8 rounded-lg bg-error-container flex items-center justify-center text-error">
                    <span class="material-symbols-outlined text-[18px]">error</span>
                </div>
                <span class="px-1.5 py-0.5 rounded-full bg-error text-on-error font-label-sm text-label-sm font-semibold">Urgent</span>
            </div>
            <div class="mt-2">
                <span class="font-metric-num text-metric-num text-error block">@Inventory.WarehouseOutOfStockCount items</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">Zero Units</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-space-sm rounded-xl shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-secondary">
                    <span class="material-symbols-outlined text-[18px]">payments</span>
                </div>
                <span class="font-label-sm text-label-sm text-secondary font-semibold">Valuation</span>
            </div>
            <div class="mt-2">
                <span class="font-metric-num text-metric-num text-on-surface block">@Inventory.CurrentCompany.CurrencySymbol @Inventory.WarehouseValuation.ToString("N0")</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1 mt-0.5">
                    <span class="text-primary font-semibold">@(Inventory.WarehouseInboundToday)↓ In</span> /
                    <span class="text-secondary font-semibold">@(Inventory.WarehouseOutboundToday)↑ Out</span>
                </span>
            </div>
        </div>
    </section>

    <!-- Frequent operations -->
    <section class="flex flex-col gap-space-xs">
        <div class="flex items-center justify-between">
            <span class="font-label-md text-label-md text-on-surface font-semibold">Company Operations</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">1-Tap Execute</span>
        </div>
        <div class="grid grid-cols-4 gap-2">
            <button type="button" @onclick="() => showNewProductModal = true" class="bg-surface-container-lowest p-2.5 rounded-xl shadow-sm flex flex-col items-center justify-center gap-1 active:scale-95 transition-transform text-center min-h-[72px]">
                <div class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">add_box</span></div>
                <span class="font-label-sm text-label-sm text-on-surface leading-tight font-medium">+ Product</span>
            </button>
            <a href="/receiving" class="bg-surface-container-lowest p-2.5 rounded-xl shadow-sm flex flex-col items-center justify-center gap-1 active:scale-95 transition-transform text-center min-h-[72px]">
                <div class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">move_to_inbox</span></div>
                <span class="font-label-sm text-label-sm text-on-surface leading-tight">Receive</span>
            </a>
            <a href="/dispatch" class="bg-surface-container-lowest p-2.5 rounded-xl shadow-sm flex flex-col items-center justify-center gap-1 active:scale-95 transition-transform text-center min-h-[72px]">
                <div class="w-9 h-9 rounded-full bg-secondary/10 text-secondary flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">local_shipping</span></div>
                <span class="font-label-sm text-label-sm text-on-surface leading-tight">Dispatch</span>
            </a>
            <a href="/inventory" class="bg-surface-container-lowest p-2.5 rounded-xl shadow-sm flex flex-col items-center justify-center gap-1 active:scale-95 transition-transform text-center min-h-[72px]">
                <div class="w-9 h-9 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">inventory</span></div>
                <span class="font-label-sm text-label-sm text-on-surface leading-tight">Catalog</span>
            </a>
        </div>
    </section>

    <a href="/achievements" class="dashboard-progress-card">
        <span class="dashboard-progress-icon"><span class="material-symbols-outlined">military_tech</span></span>
        <span class="dashboard-progress-copy"><b>Team progress</b><small>See goals and inventory milestones</small></span>
        <span class="dashboard-progress-arrow"><span class="material-symbols-outlined">arrow_forward</span></span>
    </a>

    <!-- Critical reorders -->
    @if (critical.Count > 0)
    {
        var hero = critical[0];
        <section class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-error animate-ping"></span>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Critical Reorders</h2>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-semibold">@Inventory.WarehouseOutOfStockCount Pending</span>
            </div>

            <div class="bg-surface-container-low rounded-xl p-space-sm flex flex-col gap-space-sm">
                <div class="flex items-center gap-space-sm">
                    <ProductThumb Product="hero" Class="w-14 h-14" />
                    <div class="flex flex-col min-w-0">
                        <span class="font-label-sm text-label-sm text-on-surface-variant tracking-wider uppercase">@hero.Sku</span>
                        <span class="font-label-lg text-label-lg text-on-surface truncate">@hero.Name</span>
                        <span class="font-body-sm text-body-sm @(hero.OnHand == 0 ? "text-error" : "text-amber-700") font-semibold flex items-center gap-1 mt-0.5">
                            <span class="material-symbols-outlined text-[14px]">trending_down</span>
                            Stock: @hero.OnHand / Buffer: @hero.MinLevel units
                        </span>
                    </div>
                </div>
                <div class="w-full bg-surface-container-highest h-1.5 rounded-full overflow-hidden">
                    <div class="bg-error h-full rounded-full" style="width: @(Math.Max(4, hero.StockPercent))%"></div>
                </div>
                <div class="flex items-center justify-between pt-1">
                    <div class="flex flex-col">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Vendor Lead Time</span>
                        <span class="font-label-md text-label-md text-on-surface">@hero.LeadTimeDays Days • @hero.Supplier</span>
                    </div>
                    <a href="/receiving?sku=@hero.Sku&amp;warehouse=@Uri.EscapeDataString(hero.Warehouse)" class="px-3.5 py-2 rounded-lg bg-error text-on-error font-label-md text-label-md shadow-sm active:scale-95 transition-all flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
                        Reorder Stock
                    </a>
                </div>
            </div>

            @if (critical.Count > 1)
            {
                <div class="grid grid-cols-2 gap-space-xs mt-space-sm">
                    @foreach (var p in critical.Skip(1).Take(2))
                    {
                        <a href="/product/@Uri.EscapeDataString(p.Sku)?warehouse=@Uri.EscapeDataString(p.Warehouse)" class="p-2 rounded-lg bg-surface-container-low flex items-center justify-between">
                            <div class="flex flex-col min-w-0">
                                <span class="font-label-sm text-label-sm text-on-surface truncate">@p.Sku</span>
                                <span class="font-label-sm text-label-sm text-amber-700">@p.OnHand Left (Min @p.MinLevel)</span>
                            </div>
                            <span class="material-symbols-outlined text-[16px] text-amber-600">arrow_forward</span>
                        </a>
                    }
                </div>
            }
        </section>
    }

    <!-- Movement feed -->
    <section class="flex flex-col gap-space-xs">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                <h2 class="font-headline-sm text-headline-sm text-on-surface">@Inventory.CurrentCompany.Code Movement Feed</h2>
            </div>
            <a href="/movements" class="font-label-sm text-label-sm text-secondary font-semibold flex items-center">
                View all <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
        </div>
        <div class="flex flex-col gap-space-xs">
            @if (!Inventory.Feed.Any())
            {
                <div class="bg-surface-container-lowest p-6 rounded-xl text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-[32px] text-outline mb-1">history_toggle_off</span>
                    <p class="font-body-md text-body-md">No recent movements for this company yet.</p>
                </div>
            }
            else
            {
                @foreach (var m in Inventory.Feed.Take(5))
                {
                    <article class="bg-surface-container-lowest p-space-sm rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
                        <div class="flex items-center gap-space-sm min-w-0">
                            <div class="w-10 h-10 rounded-lg flex-shrink-0 flex items-center justify-center @m.TileClass">
                                <span class="material-symbols-outlined text-[20px]">@m.Icon</span>
                            </div>
                            <div class="flex flex-col min-w-0">
                                <span class="font-label-md text-label-md text-on-surface truncate">@m.Title</span>
                                <span class="font-body-sm text-body-sm text-on-surface-variant truncate">@m.Subtitle</span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end flex-shrink-0">
                            <span class="font-metric-num text-label-lg @m.QtyClass font-bold tabular-nums">@m.QtyText</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant">@m.Ago</span>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</div>

<ScanOverlay @bind-Visible="scanning" SimulatedSku="@scanSku" OnScanned="OnScanned" />
<NewProductModal @bind-IsOpen="showNewProductModal" />

@code {
    bool scanning;
    bool showNewProductModal;
    List<Product> critical = new();

    string scanSku => Inventory.WarehouseProducts.FirstOrDefault()?.Sku ?? "";

    protected override void OnInitialized()
    {
        Refresh();
        Inventory.Changed += OnChanged;
    }

    void Refresh() => critical = Inventory.NeedsReorder.ToList();

    void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    void OnScanned(string sku) => Nav.NavigateTo($"/product/{Uri.EscapeDataString(sku)}?warehouse={Uri.EscapeDataString(Inventory.CurrentWarehouse)}");

    public void Dispose() => Inventory.Changed -= OnChanged;
}
