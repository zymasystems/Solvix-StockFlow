@page "/settings"
@layout BlankLayout
@inject SessionState Session
<h1>Notification preferences</h1>
<p>Preferences are stored on this device. Notification delivery depends on your configured alert service.</p>
<label><input type="checkbox" checked="@Session.LowStockAlertsEnabled" @onchange="e => Save(low: e.Value is true)" /> Low stock</label>
<label><input type="checkbox" checked="@Session.DailySummaryEnabled" @onchange="e => Save(daily: e.Value is true)" /> Daily summary</label>
<label><input type="checkbox" checked="@Session.InboundApprovalNotificationsEnabled" @onchange="e => Save(inbound: e.Value is true)" /> Inbound</label>
<label><input type="checkbox" checked="@Session.OutboundApprovalNotificationsEnabled" @onchange="e => Save(outbound: e.Value is true)" /> Outbound</label>
<label><input type="checkbox" checked="@Session.DispatchCompletionNotificationsEnabled" @onchange="e => Save(dispatch: e.Value is true)" /> Dispatch</label>
<a href="/workspace">Back to workspace</a>
@code {
 void Save(bool? low = null, bool? daily = null, bool? inbound = null, bool? outbound = null, bool? dispatch = null) => Session.UpdatePreferences(low ?? Session.LowStockAlertsEnabled, daily ?? Session.DailySummaryEnabled, inbound ?? Session.InboundApprovalNotificationsEnabled, outbound ?? Session.OutboundApprovalNotificationsEnabled, dispatch ?? Session.DispatchCompletionNotificationsEnabled);
}
