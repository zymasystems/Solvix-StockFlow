@inherits Solvix.Sims.Services.ConnectedComponent
@page "/product/{Sku}"
@layout StackLayout
@implements IDisposable
@inject InventoryService Inventory
@inject NavigationManager Nav

@if (product is null)
{
    <div class="flex flex-col items-center gap-2 py-space-xl text-center">
        <span class="material-symbols-outlined text-[36px] text-outline">search_off</span>
        <p class="font-body-md text-body-md text-on-surface-variant">No product found for <span class="font-mono">@Sku</span>.</p>
        <a href="/inventory" class="font-label-lg text-label-lg text-secondary">Back to inventory</a>
    </div>
}
else
{
    var p = product;
    <div class="flex flex-col w-full pb-28 space-y-space-md">

        <!-- Overview -->
        <div class="relative bg-surface-container-lowest rounded-xl p-space-md shadow-sm overflow-hidden flex flex-col gap-space-md">
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-gradient-to-br from-primary-fixed/30 to-secondary-fixed/20 rounded-full blur-2xl pointer-events-none"></div>
            <div class="flex items-start justify-between gap-space-sm relative z-10">
                <div class="flex flex-col min-w-0">
                    <div class="flex items-center flex-wrap gap-space-xs mb-1">
                        <span class="font-label-sm text-label-sm bg-surface-container text-on-surface-variant px-2 py-0.5 rounded font-mono uppercase tracking-wider">@p.Sku</span>
                        <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full @Ui.StatusBadge(p.Status)">
                            <span class="w-1.5 h-1.5 rounded-full animate-pulse @Ui.StatusDot(p.Status)"></span>
                            <span class="font-label-sm text-label-sm font-semibold tracking-wide uppercase">@Ui.StatusLabel(p.Status)</span>
                        </div>
                    </div>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface font-semibold tracking-tight leading-tight">@p.Name</h2>
                    <span class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">@p.Description</span>
                </div>
                <button aria-label="Show QR Code" @onclick="() => showQr = true"
                        class="flex-shrink-0 w-11 h-11 rounded-lg bg-surface-container-low flex flex-col items-center justify-center text-primary transition-colors active:scale-95">
                    <span class="material-symbols-outlined text-[24px]">qr_code_2</span>
                </button>
            </div>

            <div class="grid grid-cols-3 gap-space-sm items-center pt-space-xs relative z-10">
                <ProductThumb Product="p" Class="h-24 w-full" />
                <div class="col-span-2 flex flex-col justify-between h-full bg-surface-container-low rounded-lg p-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">Warehouse Bin</span>
                        <span class="font-label-sm text-label-sm text-primary font-medium flex items-center gap-0.5 truncate max-w-[160px]">
                            <span class="material-symbols-outlined text-[14px]">pin_drop</span> @(string.IsNullOrWhiteSpace(p.Warehouse) ? Inventory.CurrentCompany.DefaultSite : p.Warehouse)
                        </span>
                    </div>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">@p.Zone</span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant font-medium">/ @BinTail(p)</span>
                    </div>
                    <div class="flex items-center justify-between pt-1">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Optimal Pick Path</span>
                        <span class="font-label-sm text-label-sm bg-primary/10 text-primary font-semibold px-1.5 py-0.5 rounded">Aisle @p.Zone.Replace("Zone ", "")B</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventory status -->
        <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col space-y-space-md">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-primary text-[20px]">analytics</span>
                    <h3 class="font-label-lg text-label-lg text-on-surface">Inventory Status</h3>
                </div>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Audited 18h ago</span>
            </div>

            <div class="bg-surface-container-low rounded-lg p-3.5 flex flex-col gap-2.5">
                <div class="flex items-baseline justify-between">
                    <div>
                        <span class="font-label-sm text-label-sm uppercase font-semibold text-on-surface-variant tracking-wider">Current On-Hand</span>
                        <div class="flex items-baseline gap-2 mt-0.5">
                            <span class="font-metric-num text-headline-lg font-bold text-on-surface">@p.OnHand</span>
                            <span class="font-body-sm text-body-sm font-medium text-on-surface-variant">units</span>
                        </div>
                    </div>
                    <div class="text-right">
                        @if (p.Status != StockStatus.Optimal)
                        {
                            <span class="font-label-sm text-label-sm text-amber-900 font-semibold bg-amber-100/80 px-2 py-0.5 rounded">Reorder Alert</span>
                        }
                        <div class="font-body-sm text-body-sm text-on-surface-variant mt-1">Safety: @p.MinLevel units</div>
                    </div>
                </div>
                <div class="w-full space-y-1">
                    <div class="w-full bg-surface-container-high h-2.5 rounded-full overflow-hidden flex">
                        <div class="h-full rounded-full transition-all duration-700 @Ui.StatusDot(p.Status)" style="width: @(p.StockPercent)%"></div>
                    </div>
                    <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant">
                        <span>@p.StockPercent% of safe operational threshold</span>
                        @if (p.Deficit > 0)
                        {
                            <span class="font-semibold text-amber-800">-@p.Deficit units deficit</span>
                        }
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-2">
                <div class="bg-surface-container-low p-2.5 rounded-lg flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Unit Cost</span>
                    <span class="font-label-lg text-label-lg text-on-surface mt-1">@Ui.Money(p.UnitCost)</span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant mt-0.5">Standard FOB</span>
                </div>
                <div class="bg-surface-container-low p-2.5 rounded-lg flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Valuation</span>
                    <span class="font-label-lg text-label-lg text-on-surface mt-1">@Ui.Money(p.Valuation)</span>
                    <span class="font-label-sm text-label-sm text-tertiary mt-0.5 font-medium">@p.OnHand in stock</span>
                </div>
                <div class="bg-surface-container-low p-2.5 rounded-lg flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Lead Time</span>
                    <span class="font-label-lg text-label-lg text-on-surface mt-1">@p.LeadTimeDays Days</span>
                    <span class="font-label-sm text-label-sm text-primary font-medium mt-0.5">@p.LeadMode</span>
                </div>
            </div>

            <div class="pt-1">
                <span class="font-label-sm text-label-sm uppercase font-semibold text-on-surface-variant tracking-wider block mb-2">Availability Distribution</span>
                <div class="grid grid-cols-3 gap-2 text-center">
                    <div class="bg-primary/5 rounded-lg py-2 px-1">
                        <span class="font-label-sm text-label-sm text-primary font-medium block">Available</span>
                        <span class="font-headline-sm text-headline-sm font-bold text-primary">@p.Available</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Ready to pick</span>
                    </div>
                    <div class="bg-surface-container-high/60 rounded-lg py-2 px-1">
                        <span class="font-label-sm text-label-sm text-secondary font-medium block">Reserved</span>
                        <span class="font-headline-sm text-headline-sm font-bold text-secondary">@p.Reserved</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Allocated WO</span>
                    </div>
                    <div class="bg-surface-container rounded-lg py-2 px-1">
                        <span class="font-label-sm text-label-sm text-on-surface-variant font-medium block">Quarantined</span>
                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">@p.Quarantined</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Clean buffer</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-space-sm pt-1">
                <a href="/adjust/@Uri.EscapeDataString(p.Sku)?warehouse=@Uri.EscapeDataString(p.Warehouse)" class="h-12 rounded-lg bg-surface-container text-on-surface font-label-lg text-label-lg active:scale-95 transition-all flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">tune</span>
                    Quick Adjust
                </a>
                <a href="@($"/receiving?sku={Uri.EscapeDataString(p.Sku)}&warehouse={Uri.EscapeDataString(p.Warehouse)}")" class="h-12 rounded-lg bg-gradient-to-r from-primary-container to-secondary text-white font-label-lg text-label-lg active:scale-95 transition-all flex items-center justify-center gap-1.5 shadow-md shadow-primary/20">
                    <span class="material-symbols-outlined text-[18px]">move_to_inbox</span>Receive stock
                </a>
            </div>
        </div>

        <!-- Specs -->
        <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-3">
            <div class="flex items-center justify-between pb-1">
                <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-secondary text-[20px]">manufacturing</span>
                    <h3 class="font-label-lg text-label-lg text-on-surface">Catalog &amp; Specifications</h3>
                </div>
                <span class="font-label-sm text-label-sm text-primary font-medium flex items-center">
                    Spec Sheet <span class="material-symbols-outlined text-[14px] ml-0.5">open_in_new</span>
                </span>
            </div>
            <div class="divide-y divide-surface-container/60">
                <div class="py-2.5 flex items-center justify-between gap-3">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Category</span>
                    <span class="font-label-md text-label-md text-on-surface font-medium text-right">@p.CategoryLabel</span>
                </div>
                <div class="py-2.5 flex items-center justify-between">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Barcode (EAN-13)</span>
                    <span class="font-label-md text-label-md font-mono text-on-surface">@p.Barcode</span>
                </div>
                <div class="py-2.5 flex items-center justify-between gap-3">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Lead Vendor</span>
                    <div class="flex items-center gap-1.5">
                        <span class="font-label-md text-label-md text-on-surface font-semibold">@p.Supplier</span>
                        <span class="font-label-sm text-label-sm text-primary bg-primary/10 px-1.5 rounded font-medium">@p.SupplierNote</span>
                    </div>
                </div>
                <div class="py-2.5 flex items-center justify-between">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Reorder Threshold</span>
                    <span class="font-label-md text-label-md text-amber-900 font-semibold">@p.MinLevel Units min</span>
                </div>
                <div class="py-2.5 flex items-center justify-between">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Bin Max Limit</span>
                    <span class="font-label-md text-label-md text-on-surface">@p.MaxCapacity Units capacity</span>
                </div>
            </div>
        </div>

        <section class="stock-delete-card">
            <div><span class="material-symbols-outlined">delete_outline</span><span><b>Remove this warehouse stock item</b><small>This removes the product from this warehouse. Remaining on-hand units are written to the movement ledger as removed stock.</small></span></div>
            <button type="button" @onclick="() => showDeleteConfirm = true">Delete stock item</button>
            @if (!string.IsNullOrWhiteSpace(deleteError)) { <p role="alert">@deleteError</p> }
        </section>

        <!-- Ledger -->
        <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-md">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-on-surface-variant text-[20px]">history</span>
                    <h3 class="font-label-lg text-label-lg text-on-surface">Recent Activity Ledger</h3>
                </div>
                <a href="@($"/movements?sku={Uri.EscapeDataString(p.Sku)}&warehouse={Uri.EscapeDataString(p.Warehouse)}")" class="font-label-sm text-label-sm text-primary font-semibold">Full Audit Log</a>
            </div>
            <div class="relative pl-5 space-y-4 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-surface-container">
                @foreach (var m in ledger)
                {
                    <div class="relative flex flex-col">
                        <div class="absolute -left-5 top-1 w-2.5 h-2.5 rounded-full ring-4 ring-surface-container-lowest @m.DotClass"></div>
                        <div class="flex items-center justify-between">
                            <span class="font-label-md text-label-md text-on-surface font-semibold">@m.Title</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant">@m.Ago</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">@m.Subtitle</p>
                    </div>
                }
                @if (ledger.Count == 0)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant">No activity recorded yet.</p>
                }
            </div>
        </div>
    </div>

    <!-- Docked action bar -->
    <div class="fixed bottom-0 inset-x-0 z-40 bg-surface-container-lowest/95 backdrop-blur-md px-margin py-space-sm shadow-[0_-4px_16px_rgba(19,27,46,0.06)] pb-[calc(env(safe-area-inset-bottom,0px)+0.5rem)]">
        <div class="max-w-md mx-auto grid grid-cols-3 gap-2">
            <button @onclick="() => scanning = true" class="h-12 rounded-lg bg-surface-container-low text-on-surface flex flex-col items-center justify-center active:scale-95 transition-all">
                <span class="material-symbols-outlined text-[20px] text-primary">barcode_scanner</span>
                <span class="font-label-sm text-label-sm font-semibold tracking-tight">Scan Item</span>
            </button>
            <a href="/adjust/@Uri.EscapeDataString(p.Sku)?warehouse=@Uri.EscapeDataString(p.Warehouse)" class="h-12 rounded-lg bg-surface-container-low text-on-surface flex flex-col items-center justify-center active:scale-95 transition-all">
                <span class="material-symbols-outlined text-[20px] text-secondary">swap_vert</span>
                <span class="font-label-sm text-label-sm font-semibold tracking-tight">Count Adjust</span>
            </a>
            <a href="@($"/dispatch/new?warehouse={Uri.EscapeDataString(p.Warehouse)}")" class="h-12 rounded-lg bg-surface-container-low text-on-surface flex flex-col items-center justify-center active:scale-95 transition-all">
                <span class="material-symbols-outlined text-[20px] text-tertiary">forklift</span>
                <span class="font-label-sm text-label-sm font-semibold tracking-tight">Relocate</span>
            </a>
        </div>
    </div>

    <!-- QR dialog -->
    @if (showQr)
    {
        <div class="fixed inset-0 z-50 bg-inverse-surface/60 backdrop-blur-sm flex items-center justify-center p-margin" @onclick="() => showQr = false">
            <div class="bg-surface-container-lowest rounded-2xl p-6 w-full max-w-xs shadow-2xl flex flex-col items-center text-center" @onclick:stopPropagation="true">
                <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-[28px]">qr_code</span>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">SKU Quick Scan</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">@p.Sku</p>
                <div class="bg-white p-4 rounded-xl shadow-sm my-4 w-44 h-44 flex flex-col items-center justify-center">
                    @* Decorative placeholder. Generate a real QR from p.Sku with a library such as QRCoder when you need scannable codes. *@
                    <svg class="w-36 h-36" fill="none" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <rect fill="white" height="100" width="100"></rect>
                        <path d="M10 10H38V38H10V10Z" fill="none" stroke="#131B2E" stroke-width="4"></path>
                        <rect fill="#006B5C" height="12" width="12" x="18" y="18"></rect>
                        <path d="M62 10H90V38H62V10Z" fill="none" stroke="#131B2E" stroke-width="4"></path>
                        <rect fill="#006B5C" height="12" width="12" x="70" y="18"></rect>
                        <path d="M10 62H38V90H10V62Z" fill="none" stroke="#131B2E" stroke-width="4"></path>
                        <rect fill="#006B5C" height="12" width="12" x="18" y="70"></rect>
                        <rect fill="#131B2E" height="8" width="8" x="46" y="14"></rect>
                        <rect fill="#0060AB" height="14" width="8" x="46" y="28"></rect>
                        <rect fill="#131B2E" height="6" width="10" x="14" y="46"></rect>
                        <rect fill="#131B2E" height="10" width="6" x="28" y="48"></rect>
                        <rect fill="#006B5C" height="12" width="12" x="44" y="44"></rect>
                        <rect fill="#131B2E" height="16" width="8" x="62" y="48"></rect>
                        <rect fill="#0060AB" height="6" width="14" x="76" y="44"></rect>
                        <rect fill="#131B2E" height="8" width="16" x="74" y="62"></rect>
                        <rect fill="#131B2E" height="14" width="12" x="62" y="76"></rect>
                        <rect fill="#0060AB" height="24" width="8" x="46" y="66"></rect>
                    </svg>
                </div>
                <span class="font-mono text-[11px] text-on-surface-variant tracking-wider">@FormatBarcode(p.Barcode)</span>
                <button @onclick="() => showQr = false" class="mt-4 w-full h-11 bg-surface-container text-on-surface font-label-md text-label-md rounded-lg transition-colors">Dismiss</button>
            </div>
        </div>
    }

    @if (showDeleteConfirm)
    {
        <div class="fixed inset-0 z-50 bg-inverse-surface/60 backdrop-blur-sm flex items-center justify-center p-margin" @onclick="() => showDeleteConfirm = false">
            <section class="stock-delete-confirm" role="alertdialog" aria-modal="true" aria-labelledby="delete-stock-title" @onclick:stopPropagation="true">
                <span class="material-symbols-outlined">delete_forever</span>
                <h2 id="delete-stock-title">Delete stock item?</h2>
                <p><b>@p.Name</b> will be removed from <b>@p.Warehouse</b>. The remaining @p.OnHand unit(s) will be recorded as a stock removal in the ledger.</p>
                <p>Pending receipts, dispatches, reserved stock, or quarantined stock must be resolved first.</p>
                <div><button type="button" @onclick="() => showDeleteConfirm = false">Cancel</button><button type="button" @onclick="DeleteStock">Delete item</button></div>
            </section>
        </div>
    }

    <ScanOverlay @bind-Visible="scanning" SimulatedSku="@p.Sku" OnScanned="OnScanned" />
}

@code {
    [Parameter] public string Sku { get; set; } = "";
    [SupplyParameterFromQuery(Name = "warehouse")] public string? Warehouse { get; set; }

    Product? product;
    List<StockMovement> ledger = new();
    bool showQr, scanning, showDeleteConfirm;
    string deleteError = "";

    protected override void OnInitialized() => Inventory.Changed += OnChanged;

    protected override void OnParametersSet()
    {
        Load();
    }

    void Load()
    {
        product = Inventory.Find(Sku, Warehouse);
        ledger = product is null ? new() : Inventory.LedgerFor(product.Sku, product.Warehouse).Take(5).ToList();
    }

    void OnChanged() => InvokeAsync(() => { Load(); StateHasChanged(); });

    async Task DeleteStock()
    {
        deleteError = "";
        if (product is null) return;
        if (await Inventory.DeleteStockItemAsync(product.Sku, product.Warehouse))
        {
            showDeleteConfirm = false;
            Nav.NavigateTo("/inventory");
        }
        else deleteError = "This stock record cannot be deleted.";
    }

    void OnScanned(string sku)
    {
        if (!string.Equals(sku, Sku, StringComparison.OrdinalIgnoreCase)) Nav.NavigateTo($"/product/{Uri.EscapeDataString(sku)}?warehouse={Uri.EscapeDataString(product?.Warehouse ?? Inventory.CurrentWarehouse)}");
    }

    static string BinTail(Product p) =>
        p.BinLong.Replace(p.Zone + " • ", "").Replace("Rack ", "R-").Replace("Shelf ", "S-").Replace(" • ", " / ");

    static string FormatBarcode(string code) =>
        code.Length == 12 ? $"{code[..4]}-{code[4..8]}-{code[8..]}" : code;

    public void Dispose() => Inventory.Changed -= OnChanged;
}
