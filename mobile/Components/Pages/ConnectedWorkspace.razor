@page "/workspace"
@page "/auth-status"
@page "/dashboard"
@page "/inventory"
@page "/receiving"
@page "/receiving/approvals"
@page "/inbound-arrivals"
@page "/dispatch"
@page "/dispatch/new"
@page "/dispatch/approvals"
@page "/outbound/approvals"
@page "/staged-dispatch-approvals"
@page "/stock-adjustment"
@page "/stock-audit"
@page "/movements"
@page "/analytics"
@page "/warehouses"
@page "/suppliers"
@page "/operations"
@page "/profile"
@page "/item-intake"
@page "/product/{Sku}"
@page "/warehouse/{WarehouseName}"
@layout BlankLayout
@inject NavigationManager Nav
<Solvix.Workspace.Workbench @ref="workbench" ScanRequested="OpenScanner" InitialSection="@Section" InitialSearch="@Sku" />
<BarcodeScanner @bind-Visible="scanning" OnDetected="Detected" />
@code {
    [Parameter] public string? Sku { get; set; }
    [Parameter] public string? WarehouseName { get; set; }
    Solvix.Workspace.Workbench? workbench;
    bool scanning;
    string Section => Nav.ToBaseRelativePath(Nav.Uri).Split('/')[0] switch
    { "receiving" or "inbound-arrivals" => "Receiving", "dispatch" or "outbound" or "staged-dispatch-approvals" => "Dispatch", "stock-audit" => "Audits", "movements" or "analytics" => "Movements", "warehouses" or "suppliers" or "operations" or "profile" => "Operations", _ => "Inventory" };
    void OpenScanner() => scanning = true;
    void Detected(string value) { scanning = false; workbench?.SetScanCode(value); }
}
