@page "/warehouses"
@layout TabLayout
@inject InventoryService Inventory
@inject SessionState Session

<div class="page-stack">
    <section class="page-heading-card">
        <div><span class="eyebrow">LOCATIONS</span><h1>Warehouses</h1><p>Manage this company’s locations, site teams, contacts, and operating details.</p></div>
        <span class="material-symbols-outlined page-heading-icon">warehouse</span>
    </section>

    <a href="/warehouses/new" class="warehouse-add-link"><span class="material-symbols-outlined">add_location_alt</span><span><b>Add a warehouse</b><small>Enter the location, contacts, team information, and reference documents.</small></span><span class="material-symbols-outlined">arrow_forward</span></a>

    <section class="warehouse-grid">
        @foreach (var site in Inventory.CurrentCompany.Warehouses)
        {
            var stock = Inventory.Products.Where(p => string.Equals(p.Warehouse, site, StringComparison.OrdinalIgnoreCase)).ToList();
            var isDefault = string.Equals(site, Inventory.CurrentCompany.DefaultSite, StringComparison.OrdinalIgnoreCase);
            var isActive = string.Equals(site, Session.HubName, StringComparison.OrdinalIgnoreCase);
            <article class="warehouse-card">
                <div class="warehouse-card-top"><span class="warehouse-icon"><span class="material-symbols-outlined">warehouse</span></span><div class="warehouse-badges">@if (isDefault) { <span>Default</span> } @if (isActive) { <span class="active">Current</span> }</div></div>
                <h2>@site</h2><p>@stock.Count cataloged SKUs at this location</p>
                <div class="warehouse-metrics"><div><b>@stock.Sum(p => p.OnHand).ToString("N0")</b><small>units on hand</small></div><div><b>@stock.Count(p => p.Status != StockStatus.Optimal)</b><small>items need attention</small></div></div>
                <div class="warehouse-actions"><button type="button" @onclick="() => SetActive(site)" class="warehouse-switch">@(isActive ? "Current location" : "Use this location")</button><a href="@($"/warehouses/{Uri.EscapeDataString(site)}")">Site details <span class="material-symbols-outlined">arrow_forward</span></a></div>
            </article>
        }
    </section>
</div>

@code {
    
    void SetActive(string site) => Session.SetHub(site);
}
