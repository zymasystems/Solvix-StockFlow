@inherits Solvix.Sims.Services.ConnectedComponent
@page "/dispatch"
@layout StackLayout
@implements IDisposable
@inject InventoryService Inventory
@inject IJSRuntime JS

@{
    var order = Inventory.Dispatch;
    var outbound = Inventory.OutboundRequests.FirstOrDefault(x => x.DispatchId == order.Id);
}

@if (order.Lines.Count == 0)
{
    <div class="workflow-page"><section class="workflow-empty"><span class="material-symbols-outlined">local_shipping</span><h2>No active dispatch</h2><p>Create a dispatch from products in a selected warehouse. This manifest does not contain sample products.</p><a class="workflow-primary-button" href="/dispatch/new">Create a dispatch</a></section></div>
}
else
{
<div class="flex flex-col w-full pb-8 space-y-space-md">

    <div class="flex justify-end"><a href="/dispatch/new" class="workflow-inline-link"><span class="material-symbols-outlined">add</span>Create dispatch</a></div>

    <!-- Manifest header -->
    <div class="flex flex-col bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-sm relative overflow-hidden">
        <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-primary/5 pointer-events-none"></div>
        <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-space-xs min-w-0">
                <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold">Dispatch Manifest · @order.SourceWarehouse</span>
                <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                <span class="font-label-sm text-label-sm text-on-surface-variant font-mono">@order.WorkOrder</span>
            </div>
            @if (order.Completed)
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm shadow-sm"><span class="material-symbols-outlined text-[14px]">check_circle</span><span class="font-semibold uppercase tracking-wide">Dispatched</span></div>
            }
            else if (outbound?.ApprovalStatus == ApprovalStatus.Rejected)
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-error-container text-error font-label-sm text-label-sm shadow-sm"><span class="material-symbols-outlined text-[14px]">cancel</span><span class="font-semibold uppercase tracking-wide">Outbound rejected</span></div>
            }
            else if (order.StagedStatus == StagedDispatchStatus.Pending)
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 font-label-sm text-label-sm shadow-sm"><span class="material-symbols-outlined text-[14px]">hourglass_top</span><span class="font-semibold uppercase tracking-wide">Dispatch review pending</span></div>
            }
            else if (order.ApprovalStatus == ApprovalStatus.Rejected)
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-error-container text-error font-label-sm text-label-sm shadow-sm"><span class="material-symbols-outlined text-[14px]">cancel</span><span class="font-semibold uppercase tracking-wide">Rejected</span></div>
            }
            else if (order.StagedStatus == StagedDispatchStatus.Rejected)
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-error-container text-error font-label-sm text-label-sm shadow-sm"><span class="material-symbols-outlined text-[14px]">cancel</span><span class="font-semibold uppercase tracking-wide">Stage rejected</span></div>
            }
            else if (order.StagedStatus == StagedDispatchStatus.Approved)
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm shadow-sm"><span class="material-symbols-outlined text-[14px]">outbox</span><span class="font-semibold uppercase tracking-wide">Outbound created</span></div>
            }
            else if (order.AllVerified)
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    <span class="font-semibold uppercase tracking-wide">Ready for Dispatch</span>
                </div>
            }
            else
            {
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                    <span class="font-semibold uppercase tracking-wide">Picking</span>
                </div>
            }
        </div>
        <div class="grid grid-cols-2 gap-space-xs pt-1">
            <div class="flex flex-col p-2.5 bg-surface-container-low rounded-lg">
                <div class="flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm mb-0.5">
                    <span class="material-symbols-outlined text-[15px] text-primary">precision_manufacturing</span><span>Destination</span>
                </div>
                <span class="font-label-lg text-label-lg text-on-surface truncate">@order.Destination</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">@order.DestinationNote</span>
            </div>
            <div class="flex flex-col p-2.5 bg-surface-container-low rounded-lg">
                <div class="flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm mb-0.5">
                    <span class="material-symbols-outlined text-[15px] text-secondary">forklift</span><span>Handler / Bay</span>
                </div>
                <span class="font-label-lg text-label-lg text-on-surface truncate">@order.Handler</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">@order.HandlerNote</span>
            </div>
        </div>
    </div>

    <!-- Progress -->
    <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-xs">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[18px] text-primary">verified</span>
                <span class="font-label-lg text-label-lg text-on-surface">Picking Verification</span>
            </div>
            <span class="font-label-md text-label-md text-primary font-bold">@order.VerifiedLines of @order.Lines.Count Verified (@(order.Percent)%)</span>
        </div>
        <div class="w-full h-2.5 bg-surface-container-high rounded-full overflow-hidden flex p-0.5">
            <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: @(order.Percent)%;"></div>
        </div>
        <div class="flex justify-between items-center text-on-surface-variant font-body-sm text-body-sm pt-0.5">
            <span>@order.VerifiedUnits of @order.TotalUnits units gathered</span>
            <span class="flex items-center gap-1 text-on-surface font-label-sm text-label-sm">
                <span class="material-symbols-outlined text-[14px] text-tertiary">inventory_2</span>
                @order.Lines.Count manifest lines
            </span>
        </div>
    </div>

    <!-- Scan button -->
            @if (order.ApprovalStatus != ApprovalStatus.Rejected && order.StagedStatus == StagedDispatchStatus.NotStaged)
    {
    <button type="button" @onclick="ScanNext" disabled="@(order.AllVerified || order.Completed)"
            class="relative w-full h-14 bg-gradient-to-r from-secondary to-primary text-on-primary rounded-xl shadow-md active:scale-[0.99] transition-all flex items-center justify-between px-space-md overflow-hidden disabled:opacity-60">
        <div class="flex items-center gap-space-sm z-10">
            <div class="w-9 h-9 rounded-lg bg-surface-container-lowest/20 backdrop-blur-sm flex items-center justify-center text-on-primary">
                <span class="material-symbols-outlined text-[22px]">barcode_scanner</span>
            </div>
            <div class="flex flex-col text-left">
                <span class="font-label-lg text-label-lg tracking-tight">@(order.AllVerified ? "All items scanned" : "Tap to Scan Next Barcode")</span>
                <span class="font-body-sm text-body-sm text-on-primary/80">@(order.NextPending is { } n ? $"Pending: {n.Sku}" : "Nothing pending")</span>
            </div>
        </div>
        <div class="flex items-center gap-1 z-10 bg-surface-container-lowest/20 py-1 px-2.5 rounded-full font-label-sm text-label-sm">
            <span class="material-symbols-outlined text-[16px]">qr_code_scanner</span>
            <span>Auto-Lock</span>
        </div>
    </button>

    <!-- Picking list -->
    <div class="space-y-space-xs">
        <div class="flex items-center justify-between px-1">
            <span class="font-label-lg text-label-lg text-on-surface font-semibold">Picking Manifest Items</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">@order.Lines.Count Required</span>
        </div>

        @foreach (var line in order.Lines)
        {
            <div class="flex items-center bg-surface-container-lowest p-space-sm rounded-xl shadow-sm space-x-space-sm relative">
                <div class="w-14 h-14 rounded-lg bg-surface-container-high overflow-hidden flex-shrink-0 relative flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-[28px]">@line.Icon</span>
                    @if (line.Verified)
                    {
                        <div class="absolute top-1 left-1 w-4 h-4 rounded-full bg-primary text-on-primary flex items-center justify-center shadow">
                            <span class="material-symbols-outlined text-[11px]" style="font-variation-settings: 'FILL' 1;">check</span>
                        </div>
                    }
                    else
                    {
                        <div class="absolute top-1 left-1 w-4 h-4 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shadow">
                            <span class="material-symbols-outlined text-[11px]">pending</span>
                        </div>
                    }
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-1">
                        <h2 class="font-label-lg text-label-lg text-on-surface truncate">@line.Name</h2>
                        <span class="font-metric-num text-metric-num @(line.Verified ? "text-on-surface" : "text-secondary")">@line.Qty<span class="text-xs font-normal text-on-surface-variant ml-0.5">pcs</span></span>
                    </div>
                    <p class="font-label-sm text-label-sm font-mono text-secondary">@line.Sku</p>
                    <div class="flex items-center justify-between mt-1">
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm font-mono">
                            <span class="material-symbols-outlined text-[13px] mr-1 text-on-surface-variant">shelves</span>@line.Bin
                        </span>
                        @if (line.Verified)
                        {
                            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-primary">
                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>Verified
                            </span>
                        }
                        else
                        {
                            <button type="button" @onclick="() => ScanLine(line)" disabled="@order.Completed"
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm transition-colors">
                                <span class="material-symbols-outlined text-[14px]">barcode</span>
                                <span>Scan Unit</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    }
    else
    {
        <section class="workflow-card"><div class="workflow-section-heading"><span class="material-symbols-outlined">@(order.Completed ? "check_circle" : outbound?.ApprovalStatus == ApprovalStatus.Rejected ? "block" : order.StagedStatus == StagedDispatchStatus.Pending ? "hourglass_top" : "outbox")</span><div><h3>@(order.Completed ? "Dispatch complete" : outbound?.ApprovalStatus == ApprovalStatus.Rejected ? "Outbound rejected" : order.StagedStatus == StagedDispatchStatus.Pending ? "Staged dispatch awaiting approval" : order.StagedStatus == StagedDispatchStatus.Rejected ? "Dispatch rejected" : "Outbound created")</h3><p>@(order.Completed ? "Outbound approval is complete and source warehouse stock has been updated." : outbound?.ApprovalStatus == ApprovalStatus.Rejected ? outbound.ReviewNote : order.StagedStatus == StagedDispatchStatus.Pending ? "The scanned dispatch is in the dispatch approval queue." : order.StagedStatus == StagedDispatchStatus.Rejected ? order.ReviewNote : "This approved dispatch created an outbound that still needs verification and approval.")</p></div></div><a href="@(order.StagedStatus == StagedDispatchStatus.Pending ? "/dispatch/approvals" : "/outbound/approvals")" class="workflow-primary-button">@(order.StagedStatus == StagedDispatchStatus.Pending ? "Review dispatch approvals" : "Review outbound")</a></section>
    }

    <section class="workflow-card">
        <div class="workflow-section-heading"><span class="material-symbols-outlined">route</span><div><h3>Dispatch details</h3><p>Use this reference when reviewing the staged load and outbound.</p></div></div>
        <div class="workflow-two-col"><label>Work order<input value="@order.WorkOrder" readonly /></label><label>Dispatch lead<input value="@order.Handler" readonly /></label></div>
        @if (!string.IsNullOrWhiteSpace(order.Note)) { <p class="approval-note">@order.Note</p> }
    </section>
    <!-- Actions -->
    <div class="flex flex-col gap-space-xs pt-2">
        @if (order.StagedStatus == StagedDispatchStatus.Pending)
        {
            <a href="/dispatch/approvals" class="workflow-primary-button"><span class="material-symbols-outlined">fact_check</span>Review staged dispatch</a>
        }
        else if (order.StagedStatus == StagedDispatchStatus.Approved)
        {
            <a href="/outbound/approvals" class="workflow-primary-button"><span class="material-symbols-outlined">outbox</span>Review outbound</a>
        }
        else if (order.StagedStatus == StagedDispatchStatus.Rejected)
        {
            <p class="workflow-error">Staged load rejected: @order.StagedReviewNote</p>
            <a href="@($"/dispatch/new?warehouse={Uri.EscapeDataString(order.SourceWarehouse)}")" class="workflow-primary-button"><span class="material-symbols-outlined">replay</span>Create replacement dispatch</a>
        }
        else if (!order.AllVerified && !order.Completed)
        {
            <p class="text-center font-body-sm text-body-sm text-on-surface-variant">Scan every item to stage this dispatch for review.</p>
        }
        @if (order.Lines.Count > 0)
        {
            <button type="button" @onclick="PrintManifestAsync" class="h-10 rounded-lg bg-surface-container-high text-on-surface font-label-md text-label-md flex items-center justify-center gap-1.5 active:bg-surface-variant transition-colors">
                <span class="material-symbols-outlined text-[17px]">print</span><span>Print manifest</span>
            </button>
        }
    </div>
</div>
}

<!-- Scan toast -->
@if (toast is not null)
{
    <div class="fixed inset-x-4 bottom-[calc(1.5rem+env(safe-area-inset-bottom,0px))] p-4 rounded-xl bg-inverse-surface text-inverse-on-surface shadow-2xl flex items-center justify-between z-50">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary">
                <span class="material-symbols-outlined text-[18px]">done_all</span>
            </div>
            <div class="flex flex-col">
                <span class="font-label-md text-label-md">@toast.Title</span>
                <span class="font-body-sm text-body-sm text-inverse-on-surface/80">@toast.Detail</span>
            </div>
        </div>
        <button type="button" aria-label="Dismiss" @onclick="() => toast = null" class="text-inverse-on-surface/80">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>
}

<BarcodeScanner @bind-Visible="scannerOpen" OnDetected="OnBarcodeDetected" />

@code {
    record Toast(string Title, string Detail);

    Toast? toast;
    CancellationTokenSource? toastCts;

    protected override void OnInitialized() => Inventory.Changed += OnChanged;

    void OnChanged() => InvokeAsync(StateHasChanged);

    bool scannerOpen;
    DispatchLine? scanTarget;

    Task ScanNext()
    {
        scanTarget = Inventory.Dispatch.NextPending;
        scannerOpen = scanTarget is not null;
        return Task.CompletedTask;
    }

    Task ScanLine(DispatchLine target)
    {
        scanTarget = target;
        scannerOpen = true;
        return Task.CompletedTask;
    }

    async Task OnBarcodeDetected(string code)
    {
        if (scanTarget is null) return;
        if (await Inventory.VerifyDispatchItemAsync(code, scanTarget.Sku)) await ShowToast(scanTarget);
        else
        {
            toast = new Toast("Item not on this line", $"Scanned {code}; expected {scanTarget.Sku}. Check the label and try again.");
            StateHasChanged();
        }
        scanTarget = null;
    }

    async Task ShowToast(DispatchLine line)
    {
        var order = Inventory.Dispatch;
        var detail = order.AllVerified
            ? $"All {order.Lines.Count} outbound SKUs 100% verified"
            : $"{order.VerifiedLines} of {order.Lines.Count} verified";
        toast = new Toast($"SKU: {line.Sku} Scanned!", detail);

        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;
        try
        {
            await Task.Delay(4500, token);
            toast = null;
        }
        catch (TaskCanceledException) { }
    }

    async Task PrintManifestAsync()
    {
        static string H(string? value) => System.Net.WebUtility.HtmlEncode(value ?? "");
        var order = Inventory.Dispatch;
        var rows = string.Join("", order.Lines.Select(line => $"<tr><td>{H(line.Sku)}</td><td>{H(line.Name)}</td><td>{H(line.Bin)}</td><td>{line.Qty:N0}</td><td>{(line.Verified ? "Verified" : "Pending")}</td></tr>"));
        var html = $"<!doctype html><html><head><meta charset='utf-8'><title>Dispatch {H(order.WorkOrder)}</title><style>body{{font:14px Arial,sans-serif;color:#183249;margin:32px}}h1{{margin-bottom:4px}}p{{color:#718091}}table{{border-collapse:collapse;width:100%;margin-top:24px}}th,td{{text-align:left;padding:10px 8px;border-bottom:1px solid #dce5e9}}th{{background:#eef4f5}}</style></head><body><h1>Dispatch manifest</h1><p>Work order: {H(order.WorkOrder)} · Source: {H(order.SourceWarehouse)} · Destination: {H(order.Destination)} · Lead: {H(order.Handler)}</p><table><thead><tr><th>SKU</th><th>Product</th><th>Bin</th><th>Qty</th><th>Pick status</th></tr></thead><tbody>{rows}</tbody></table><p>Notes: {H(order.Note)}</p></body></html>";
        await JS.InvokeVoidAsync("solvixExports.print", html);
    }
    public void Dispose()
    {
        Inventory.Changed -= OnChanged;
        toastCts?.Cancel();
    }
}
