@page "/receiving/approvals"
@layout StackLayout
@implements IDisposable
@inject InventoryService Inventory

<div class="approval-page">
    <section class="approval-hero inbound-approval-hero">
        <a href="/operations" class="approval-back-link"><span class="material-symbols-outlined">arrow_back</span>Operations</a>
        <div class="approval-hero-row"><div class="approval-hero-icon"><span class="material-symbols-outlined">move_to_inbox</span></div><div><span class="workflow-eyebrow">INBOUND CONTROL · @Inventory.CurrentWarehouse</span><h1>Verify &amp; approve receipts</h1><p>Scan the product, then approve before stock is added to this warehouse.</p></div></div>
        <div class="approval-hero-count"><b>@Requests.Count(x => x.ApprovalStatus == ApprovalStatus.Pending)</b><span>waiting for review</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message)) { <p class="workflow-success"><span class="material-symbols-outlined">check_circle</span>@message</p> }
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="workflow-error"><span class="material-symbols-outlined">error</span>@error</p> }

    @if (!Requests.Any())
    {
        <section class="approval-empty"><span class="material-symbols-outlined">task_alt</span><h2>No inbound requests yet</h2><p>Record a delivery and it will appear here before changing your stock.</p><a href="/receiving" class="workflow-primary-button">Create inbound</a></section>
    }
    else
    {
        @foreach (var request in Requests.OrderBy(x => x.ApprovalStatus == ApprovalStatus.Pending ? 0 : 1).ThenByDescending(x => x.CreatedAt))
        {
            <article class="approval-request-card">
                <div class="approval-request-top"><div><span class="approval-reference">Receipt request</span><span class="approval-status @request.ApprovalStatus.ToString().ToLowerInvariant()">@request.ApprovalStatus</span></div><small>@request.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small></div>
                <h2>@request.ProductName</h2>
                <p class="approval-subtitle">@request.Sku · @request.Warehouse</p>
                <div class="approval-request-stats"><div><span>Quantity</span><b>+@request.Quantity units</b></div><div><span>Reference</span><b>@(string.IsNullOrWhiteSpace(request.Reference) ? "—" : request.Reference)</b></div></div>
                @if (!string.IsNullOrWhiteSpace(request.Notes)) { <p class="approval-note">@request.Notes</p> }
                @if (request.ApprovalStatus == ApprovalStatus.Pending)
                {
                    @if (request.RequiresArrivalConfirmation && !request.Arrived)
                    {
                        <div class="staged-release-hint"><span class="material-symbols-outlined">local_shipping</span>Transfer is still awaiting arrival. No stock has been added to this warehouse.</div>
                        <a class="approval-open-link" href="@($"/receiving/arrivals?warehouse={Uri.EscapeDataString(request.Warehouse)}")"><span class="material-symbols-outlined">warehouse</span>Confirm destination arrival</a>
                    }
                    else
                    {
                        <div class="staged-release-hint"><span class="material-symbols-outlined">@(request.Verified ? "verified" : "qr_code_scanner")</span>@(request.Verified ? $"Barcode verified at {request.VerifiedAt:dd MMM HH:mm}. Ready for approval." : "Verify the delivered product barcode before approving this receipt.")</div>
                        <div class="approval-buttons"><button type="button" class="approval-reject" @onclick="() => Reject(request)"><span class="material-symbols-outlined">close</span>Reject</button><button type="button" class="approval-reject" @onclick="() => Verify(request)"><span class="material-symbols-outlined">barcode_scanner</span>@(request.Verified ? "Verified" : "Verify SKU")</button><button type="button" class="approval-accept" disabled="@(!request.Verified)" @onclick="() => Approve(request)"><span class="material-symbols-outlined">check</span>Approve &amp; receive</button></div>
                    }
                }
                @if (request.ReviewedAt is not null) { <small class="approval-review-date">Reviewed @request.ReviewedAt.Value.ToString("dd MMM yyyy, HH:mm") @if (!string.IsNullOrWhiteSpace(request.ReviewNote)) { <span>· @request.ReviewNote</span> }</small> }
                @if (request.ApprovalStatus == ApprovalStatus.Rejected) { <a class="approval-open-link" href="@($"/receiving?sku={Uri.EscapeDataString(request.Sku)}&warehouse={Uri.EscapeDataString(request.Warehouse)}")"><span class="material-symbols-outlined">replay</span>Create replacement receipt</a> }
            </article>
        }
    }
</div>

<BarcodeScanner @bind-Visible="scannerOpen" OnDetected="OnBarcode" />

@code {
    [SupplyParameterFromQuery(Name = "warehouse")] public string? Warehouse { get; set; }
    string message = "", error = "";
    bool scannerOpen;
    string scanRequestId = "";
    IEnumerable<InboundOrder> Requests => Inventory.InboundRequests.Where(x => x.CompanyId == Inventory.CurrentCompanyId && x.Warehouse == Inventory.CurrentWarehouse);

    protected override void OnInitialized() => Inventory.Changed += Refresh;
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Warehouse)) Inventory.SelectWarehouse(Warehouse);
    }
    void Refresh() => InvokeAsync(StateHasChanged);
    void Verify(InboundOrder request) { scanRequestId = request.Id; scannerOpen = true; }
    void OnBarcode(string code)
    {
        message = error = "";
        if (Inventory.VerifyInbound(scanRequestId, code)) message = $"Verified barcode {code}. The receipt can now be approved.";
        else error = $"Barcode {code} does not match this receipt's SKU.";
    }
    void Approve(InboundOrder request)
    {
        message = error = "";
        if (Inventory.ReviewInbound(request.Id, true)) message = $"Received {request.Quantity} units of {request.ProductName} into stock.";
        else error = "Verify the product barcode and confirm the receiving warehouse before approval.";
    }
    void Reject(InboundOrder request)
    {
        message = error = "";
        if (Inventory.ReviewInbound(request.Id, false, "Rejected from inbound approvals.")) message = "Inbound request rejected. Stock was not changed.";
    }
    public void Dispose() => Inventory.Changed -= Refresh;
}
