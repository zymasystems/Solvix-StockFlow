@inherits Solvix.Sims.Services.ConnectedComponent
@page "/receiving/arrivals"
@layout StackLayout
@implements IDisposable
@inject InventoryService Inventory

<div class="arrival-page">
    <section class="arrival-hero">
        <div class="arrival-hero-icon"><span class="material-symbols-outlined">warehouse</span></div>
        <div><span class="arrival-eyebrow">WAREHOUSE TRANSFERS · @Inventory.CurrentWarehouse</span><h1>Confirm arrivals</h1><p>Confirm the transfer reached this warehouse before stock can be checked in.</p></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message)) { <div class="arrival-feedback success"><span class="material-symbols-outlined">check_circle</span><span>@message</span><a href="@($"/receiving/approvals?warehouse={Uri.EscapeDataString(Inventory.CurrentWarehouse)}")">Continue to inbound review</a></div> }
    @if (!string.IsNullOrWhiteSpace(error)) { <div class="arrival-feedback error"><span class="material-symbols-outlined">error</span>@error</div> }

    @if (!Pending.Any())
    {
        <section class="arrival-empty"><span class="material-symbols-outlined">inventory</span><h2>No transfers awaiting arrival</h2><p>Approved transfers to this warehouse will appear here. Stock remains unchanged until it arrives and passes inbound approval.</p><a href="/operations" class="arrival-button secondary">Back to operations</a></section>
    }
    else
    {
        <div class="arrival-list">
            @foreach (var request in Pending.OrderBy(x => x.CreatedAt))
            {
                <article class="arrival-card">
                    <div class="arrival-card-top"><span class="arrival-state"><span class="material-symbols-outlined">local_shipping</span>In transit</span><time>@request.CreatedAt.ToString("dd MMM yyyy · HH:mm")</time></div>
                    <h2>@request.ProductName</h2>
                    <p class="arrival-sku">@request.Sku · @request.Quantity.ToString("N0") units</p>
                    <div class="arrival-route"><span><small>From</small><b>@request.SourceWarehouse</b></span><span class="material-symbols-outlined">arrow_forward</span><span><small>To</small><b>@request.Warehouse</b></span></div>
                    @if (!string.IsNullOrWhiteSpace(request.Reference)) { <p class="arrival-reference">Transfer reference <b>@request.Reference</b></p> }
                    <button type="button" class="arrival-button primary" @onclick="() => Confirm(request)"><span class="material-symbols-outlined">move_to_inbox</span>Confirm arrival</button>
                </article>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "warehouse")] public string? Warehouse { get; set; }
    string message = "", error = "";
    IEnumerable<InboundOrder> Pending => Inventory.InboundRequests.Where(x => x.CompanyId == Inventory.CurrentCompanyId && x.Warehouse.Equals(Inventory.CurrentWarehouse, StringComparison.OrdinalIgnoreCase) && x.ApprovalStatus == ApprovalStatus.Pending && x.RequiresArrivalConfirmation && !x.Arrived);

    protected override void OnInitialized() => Inventory.Changed += Refresh;
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Warehouse)) Inventory.SelectWarehouse(Warehouse);
    }

    void Refresh() => InvokeAsync(StateHasChanged);
    async Task Confirm(InboundOrder request)
    {
        error = "";
        if (await Inventory.ConfirmInboundArrivalAsync(request.Id)) message = $"Arrival confirmed for {request.Sku}. Verify and approve it in inbound review before adding it to stock.";
        else error = "This transfer is no longer waiting for arrival. Refresh the queue and try again.";
    }
    public void Dispose() => Inventory.Changed -= Refresh;
}
