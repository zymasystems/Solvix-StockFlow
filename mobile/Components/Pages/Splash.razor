@page "/"
@layout BlankLayout
@inject NavigationManager Nav

<main class="launch-splash" aria-label="Solvix SIMS starting">
    <div class="splash-glow splash-glow-one"></div><div class="splash-glow splash-glow-two"></div>
    <div class="launch-splash-content">
        <div class="splash-brand-lockup"><img class="launch-splash-logo" src="/image/Logo.png" alt="Solvix SIMS" /></div>
        <span class="launch-splash-caption"><i></i>WAREHOUSE OPERATIONS, IN SYNC</span>
        <p class="launch-splash-tagline">One clear view of every warehouse.</p>
        <div class="launch-splash-loader" role="status" aria-label="Loading introduction"><span></span></div>
    </div>
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1400);
        Nav.NavigateTo("/welcome", replace: true);
    }
}
