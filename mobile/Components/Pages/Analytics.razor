@inherits Solvix.Sims.Services.ConnectedComponent
@page "/analytics"
@layout TabLayout
@implements IDisposable
@inject InventoryService Inventory
@inject IJSRuntime JS

<div class="analytics-v2">
    <section class="analytics-v2-hero">
        <div class="analytics-v2-heading"><span class="analytics-v2-eyebrow">BUSINESS OVERVIEW</span><h1>Analytics</h1><p>Clear, current performance for the selected warehouse.</p></div>
        <label class="analytics-v2-warehouse"><span class="material-symbols-outlined">warehouse</span><select value="@Inventory.CurrentWarehouse" @onchange="WarehouseChanged" aria-label="Analytics warehouse">@foreach (var site in Inventory.CurrentCompany.Warehouses) { <option value="@site">@site</option> }</select><span class="material-symbols-outlined">expand_more</span></label>
    </section>

    <section class="analytics-v2-kpis" aria-label="Warehouse stock summary">
        <article><span class="analytics-v2-kpi-icon teal"><span class="material-symbols-outlined">inventory_2</span></span><div><small>Products in warehouse</small><b>@Inventory.WarehouseProducts.Count.ToString("N0")</b><span>Active catalogue items</span></div></article>
        <article><span class="analytics-v2-kpi-icon blue"><span class="material-symbols-outlined">deployed_code</span></span><div><small>Units on hand</small><b>@Inventory.WarehouseProducts.Sum(x => x.OnHand).ToString("N0")</b><span>@Inventory.CurrentWarehouse</span></div></article>
        <article><span class="analytics-v2-kpi-icon gold"><span class="material-symbols-outlined">payments</span></span><div><small>Stock valuation</small><b>@Inventory.CurrentCompany.CurrencySymbol @Inventory.WarehouseValuation.ToString("N0")</b><span>Current on-hand value</span></div></article>
        <article><span class="analytics-v2-kpi-icon coral"><span class="material-symbols-outlined">warning</span></span><div><small>Items needing attention</small><b>@AttentionProducts.Count.ToString("N0")</b><span>@OutOfStockCount out · @LowStockCount low</span></div></article>
    </section>

    <section class="analytics-v2-card">
        <div class="analytics-v2-card-heading"><div><span class="analytics-v2-eyebrow">STOCK HEALTH</span><h2>Needs attention</h2><p>Products below their minimum level in this warehouse.</p></div><a class="analytics-v2-text-link" href="/inventory">View stock <span class="material-symbols-outlined">arrow_forward</span></a></div>
        @if (AttentionProducts.Count == 0)
        {
            <div class="analytics-v2-empty"><span class="material-symbols-outlined">task_alt</span><span>All warehouse products are at or above their minimum stock level.</span></div>
        }
        else
        {
            <div class="analytics-v2-risk-list">
                @foreach (var product in AttentionProducts.Take(5))
                {
                    <a href="@($"/product/{Uri.EscapeDataString(product.Sku)}?warehouse={Uri.EscapeDataString(product.Warehouse)}")"><span class="analytics-v2-risk-icon @(product.Status == StockStatus.OutOfStock ? "empty" : "low")"><span class="material-symbols-outlined">@(product.Status == StockStatus.OutOfStock ? "production_quantity_limits" : "trending_down")</span></span><span><b>@product.Name</b><small>@product.Sku · minimum @product.MinLevel units</small></span><strong>@product.OnHand</strong></a>
                }
            </div>
        }
    </section>

    <section class="analytics-v2-card">
        <div class="analytics-v2-card-heading"><div><span class="analytics-v2-eyebrow">MOVEMENT SUMMARY</span><h2>Stock movement</h2><p>Approved receipts and dispatches · @Inventory.CurrentWarehouse</p></div><span class="analytics-v2-heading-icon material-symbols-outlined">bar_chart</span></div>
        <div class="analytics-v2-range" role="group" aria-label="Movement date range">@foreach (var option in RangeOptions) { <button type="button" class="@(range == option.Key ? "active" : "")" @onclick="() => range = option.Key">@option.Label</button> }</div>
        <div class="analytics-v2-totals"><div><span class="analytics-v2-legend inbound"></span><span>Received</span><b>@InboundUnits.ToString("N0")</b></div><div><span class="analytics-v2-legend outbound"></span><span>Dispatched</span><b>@OutboundUnits.ToString("N0")</b></div><span class="analytics-v2-period">@RangeLabel</span></div>
        @if (ActivityBuckets.All(x => x.Inbound == 0 && x.Outbound == 0))
        {
            <div class="analytics-v2-empty"><span class="material-symbols-outlined">bar_chart</span><span>No approved stock movement in this period.</span></div>
        }
        else
        {
            var max = Math.Max(1, ActivityBuckets.Max(x => Math.Max(x.Inbound, x.Outbound)));
            <div class="analytics-v2-chart" role="img" aria-label="Grouped inbound and outbound stock movement bars">
                @foreach (var bucket in ActivityBuckets)
                {
                    <div class="analytics-v2-chart-column" aria-label="@bucket.Label: @bucket.Inbound received, @bucket.Outbound dispatched">
                        <div class="analytics-v2-chart-values"><span>@bucket.Inbound.ToString("N0")</span><span>@bucket.Outbound.ToString("N0")</span></div>
                        <div class="analytics-v2-chart-bars"><i class="inbound" style="height:@BarHeight(bucket.Inbound, max)%"></i><i class="outbound" style="height:@BarHeight(bucket.Outbound, max)%"></i></div>
                        <span class="analytics-v2-chart-label">@bucket.Label</span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="analytics-v2-card">
        <div class="analytics-v2-card-heading"><div><span class="analytics-v2-eyebrow">CURRENT INVENTORY</span><h2>Stock by category</h2><p>Warehouse valuation grouped by product category.</p></div><a class="analytics-v2-text-link" href="/inventory">Inventory <span class="material-symbols-outlined">arrow_forward</span></a></div>
        @if (CategoryBreakdown.Count == 0)
        {
            <div class="analytics-v2-empty"><span class="material-symbols-outlined">category</span><span>No products are catalogued at this warehouse yet.</span></div>
        }
        else
        {
            <div class="analytics-v2-category-list">
                @foreach (var category in CategoryBreakdown)
                {
                    <div class="analytics-v2-category"><div><span class="analytics-v2-category-name"><i style="background:@category.Color"></i>@category.Name</span><b>@Inventory.CurrentCompany.CurrencySymbol @category.Value.ToString("N0")</b></div><div class="analytics-v2-track"><i style="width:@category.Percent%;background:@category.Color"></i></div><small>@category.Percent% of warehouse stock value</small></div>
                }
            </div>
        }
    </section>

    <section class="analytics-v2-card">
        <div class="analytics-v2-card-heading"><div><span class="analytics-v2-eyebrow">LATEST LEDGER ENTRIES</span><h2>Recent movement</h2><p>Actual stock changes recorded at this warehouse.</p></div><a class="analytics-v2-text-link" href="/movements?warehouse=@Uri.EscapeDataString(Inventory.CurrentWarehouse)">Full movement feed <span class="material-symbols-outlined">arrow_forward</span></a></div>
        @if (LatestMovements.Count == 0)
        {
            <div class="analytics-v2-empty"><span class="material-symbols-outlined">history</span><span>No stock movements have been recorded here yet.</span></div>
        }
        else
        {
            <div class="analytics-v2-feed">
                @foreach (var movement in LatestMovements)
                {
                    <article><span class="analytics-v2-feed-icon @KindClass(movement.Kind)"><span class="material-symbols-outlined">@movement.Icon</span></span><span class="analytics-v2-feed-copy"><b>@movement.Title</b><small>@movement.Subtitle</small><small>@movement.At.ToString("dd MMM yyyy, HH:mm") · @movement.Kind</small></span><strong class="@KindClass(movement.Kind)">@movement.Delta.ToString("+#,##0;-#,##0;0")</strong></article>
                }
            </div>
        }
    </section>

    <section class="analytics-v2-card analytics-v2-export">
        <div><span class="analytics-v2-eyebrow">REPORTS</span><h2>Take your data with you</h2><p>Export a snapshot of this warehouse's stock and current movement period.</p></div>
        <div><button type="button" @onclick="ExportCsvAsync"><span class="material-symbols-outlined">table_view</span>Export CSV</button><button type="button" @onclick="ExportPdfAsync"><span class="material-symbols-outlined">print</span>Print summary</button></div>
    </section>
</div>

@code {
    private sealed record RangeOption(string Key, string Label);
    private sealed record ActivityBucket(string Label, long Inbound, long Outbound);
    private sealed record CategorySummary(string Name, decimal Value, int Percent, string Color);
    private static readonly RangeOption[] RangeOptions = [new("7 days", "7 days"), new("30 days", "30 days"), new("90 days", "90 days")];
    private static readonly string[] ChartColors = ["#087d73", "#3975a1", "#bd7c2b", "#8065a6", "#c46055", "#4a91a0"];
    private string range = "30 days";
    private string RangeLabel => range;
    private DateTime RangeStart => range switch { "7 days" => DateTime.Today.AddDays(-6), "90 days" => DateTime.Today.AddDays(-89), _ => DateTime.Today.AddDays(-29) };
    private List<StockMovement> WarehouseMovements => Inventory.Movements.Where(x => x.CompanyId == Inventory.CurrentCompanyId && string.Equals(x.Warehouse, Inventory.CurrentWarehouse, StringComparison.OrdinalIgnoreCase)).ToList();
    private List<StockMovement> RangeMovements => WarehouseMovements.Where(x => x.At >= RangeStart && x.At <= DateTime.Now).ToList();
    private List<StockMovement> LatestMovements => WarehouseMovements.OrderByDescending(x => x.At).Take(6).ToList();
    private long InboundUnits => RangeMovements.Where(x => x.Kind == MovementKind.Inbound).Sum(x => Math.Max(0, x.Delta));
    private long OutboundUnits => RangeMovements.Where(x => x.Kind == MovementKind.Outbound).Sum(x => Math.Abs(x.Delta));
    private List<Product> AttentionProducts => Inventory.WarehouseProducts.Where(x => x.Status != StockStatus.Optimal).OrderBy(x => x.OnHand).ToList();
    private int OutOfStockCount => Inventory.WarehouseProducts.Count(x => x.Status == StockStatus.OutOfStock);
    private int LowStockCount => Inventory.WarehouseProducts.Count(x => x.Status == StockStatus.Low);

    private List<ActivityBucket> ActivityBuckets
    {
        get
        {
            var result = new List<ActivityBucket>();
            var count = range == "7 days" ? 7 : range == "30 days" ? 6 : 3;
            for (var i = 0; i < count; i++)
            {
                DateTime from, to;
                string label;
                if (range == "7 days") { from = DateTime.Today.AddDays(-6 + i); to = from.AddDays(1); label = from.ToString("ddd"); }
                else if (range == "30 days") { from = DateTime.Today.AddDays(-29 + i * 5); to = from.AddDays(5); label = from.ToString("dd MMM"); }
                else { var month = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1); from = month.AddMonths(-2 + i); to = from.AddMonths(1); label = from.ToString("MMM"); }
                var moves = RangeMovements.Where(x => x.At >= from && x.At < to).ToList();
                result.Add(new ActivityBucket(label, moves.Where(x => x.Kind == MovementKind.Inbound).Sum(x => Math.Max(0, x.Delta)), moves.Where(x => x.Kind == MovementKind.Outbound).Sum(x => Math.Abs(x.Delta))));
            }
            return result;
        }
    }

    private List<CategorySummary> CategoryBreakdown
    {
        get
        {
            var allGroups = Inventory.WarehouseProducts.GroupBy(p => string.IsNullOrWhiteSpace(p.Group) ? "Uncategorized" : p.Group).Select(g => (Name: g.Key, Value: g.Sum(p => p.Valuation))).OrderByDescending(x => x.Value).ToList();
            var total = allGroups.Sum(x => x.Value);
            var visibleGroups = allGroups.Take(5).ToList();
            var otherValue = allGroups.Skip(5).Sum(x => x.Value);
            if (otherValue > 0) visibleGroups.Add(("Other categories", otherValue));
            return visibleGroups.Select((x, i) => new CategorySummary(x.Name, x.Value, total <= 0 ? 0 : (int)Math.Round(x.Value * 100m / total), ChartColors[i % ChartColors.Length])).ToList();
        }
    }

    private static int BarHeight(long value, long max) => value == 0 ? 0 : Math.Max(5, (int)Math.Round(value * 100.0 / max));
    private static string KindClass(MovementKind kind) => kind switch { MovementKind.Inbound => "inbound", MovementKind.Outbound => "outbound", MovementKind.Adjustment => "adjustment", _ => "quality" };
    protected override void OnInitialized() => Inventory.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void WarehouseChanged(ChangeEventArgs e) { if (e.Value is string site) Inventory.SelectWarehouse(site); }
    private static string Csv(string? value) => "\"" + (value ?? "").Replace("\"", "\"\"") + "\"";

    private async Task ExportCsvAsync()
    {
        var rows = new List<string> { "Record type,Date,SKU,Item,Warehouse,Movement,Quantity,On hand,Unit cost,Value,Notes" };
        rows.AddRange(Inventory.WarehouseProducts.Select(p => string.Join(",", new[] { Csv("Stock"), Csv(DateTime.Now.ToString("yyyy-MM-dd")), Csv(p.Sku), Csv(p.Name), Csv(p.Warehouse), Csv(""), Csv(""), Csv(p.OnHand.ToString()), Csv(p.UnitCost.ToString("0.00")), Csv(p.Valuation.ToString("0.00")), Csv(p.SupplierNote) })));
        rows.AddRange(RangeMovements.Select(m => string.Join(",", new[] { Csv(m.Kind.ToString()), Csv(m.At.ToString("yyyy-MM-dd HH:mm")), Csv(m.Sku), Csv(m.Title), Csv(m.Warehouse), Csv(m.Kind.ToString()), Csv(m.Delta.ToString()), Csv(""), Csv(""), Csv(""), Csv(m.Subtitle) })));
        await JS.InvokeVoidAsync("solvixExports.download", $"{Inventory.CurrentCompany.Code}-{Inventory.CurrentWarehouse}-analytics-{DateTime.Now:yyyyMMdd}.csv", "\uFEFF" + string.Join("\r\n", rows), "text/csv;charset=utf-8");
    }

    private async Task ExportPdfAsync()
    {
        static string H(string? value) => System.Net.WebUtility.HtmlEncode(value ?? "");
        var rows = string.Join("", Inventory.WarehouseProducts.OrderBy(x => x.Name).Select(p => $"<tr><td>{H(p.Sku)}</td><td>{H(p.Name)}</td><td>{p.OnHand:N0}</td><td>{H(p.Status.ToString())}</td><td>{H(Inventory.CurrentCompany.CurrencySymbol)}{p.Valuation:N2}</td></tr>"));
        var html = $"<!doctype html><html><head><meta charset='utf-8'><title>{H(Inventory.CurrentCompany.Name)} stock report</title><style>body{{font:14px Arial,sans-serif;color:#183249;margin:32px}}h1{{margin-bottom:4px}}p{{color:#718091}}table{{border-collapse:collapse;width:100%;margin-top:24px}}th,td{{text-align:left;padding:10px 8px;border-bottom:1px solid #dce5e9}}th{{background:#eef4f5}}</style></head><body><h1>{H(Inventory.CurrentCompany.Name)}</h1><p>{H(Inventory.CurrentWarehouse)} · {DateTime.Now:dd MMM yyyy HH:mm}</p><p>SKUs: {Inventory.WarehouseProducts.Count} · Units: {Inventory.WarehouseProducts.Sum(x => x.OnHand):N0} · Value: {H(Inventory.CurrentCompany.CurrencySymbol)}{Inventory.WarehouseValuation:N2}</p><p>{RangeLabel} movement: {InboundUnits:N0} received · {OutboundUnits:N0} dispatched</p><table><thead><tr><th>SKU</th><th>Product</th><th>On hand</th><th>Status</th><th>Value</th></tr></thead><tbody>{rows}</tbody></table></body></html>";
        await JS.InvokeVoidAsync("solvixExports.print", html);
    }
    public void Dispose() => Inventory.Changed -= OnChanged;
}
