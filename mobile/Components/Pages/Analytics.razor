@page "/analytics"
@layout TabLayout
@implements IDisposable
@inject InventoryService Inventory
@inject SessionState Session
@inject IJSRuntime JS

<div class="flex flex-col w-full gap-space-md">

    <!-- Company + Hub + Range -->
    <div class="flex flex-col gap-space-sm">
        <div class="flex items-center justify-between">
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-high text-on-surface max-w-[70%]">
                <span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">warehouse</span>
                <span class="font-label-md text-label-md truncate">@Inventory.CurrentCompany.Code • @Session.HubName</span>
            </div>
            <div class="flex items-center gap-1.5 text-on-surface-variant font-label-sm text-label-sm">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                <span>Live Tenant Sync</span>
            </div>
        </div>
        <div class="flex items-center gap-space-xs overflow-x-auto no-scrollbar py-0.5">
            @foreach (var r in ranges)
            {
                var active = range == r;
                <button @onclick="() => range = r"
                        class="px-3 py-1.5 rounded-full font-label-md text-label-md whitespace-nowrap active:scale-95 transition-all flex items-center gap-1 @(active ? "bg-primary text-on-primary shadow-sm" : "bg-surface-container text-on-surface-variant")">
                    @if (active)
                    {
                        <span class="material-symbols-outlined text-[14px]">calendar_today</span>
                    }
                    @r
                </button>
            }
        </div>
    </div>

    <!-- KPI bento -->
    <div class="grid grid-cols-2 gap-space-sm">
        <div class="bg-surface-container-lowest p-3.5 rounded-xl shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Turnover Rate</span>
                <div class="w-7 h-7 rounded-lg bg-primary-fixed/40 flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[18px]">autorenew</span></div>
            </div>
            <div class="mt-2">
                <div class="font-headline-md text-headline-md text-on-surface tracking-tight">4.8x</div>
                <div class="flex items-center gap-1 mt-1 text-[#065F46] font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[14px]">trending_up</span>
                    <span class="font-semibold">+0.6</span>
                    <span class="text-on-surface-variant font-normal">vs prev mo</span>
                </div>
            </div>
        </div>
        <div class="bg-surface-container-lowest p-3.5 rounded-xl shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Catalog SKUs</span>
                <div class="w-7 h-7 rounded-lg bg-secondary-fixed/50 flex items-center justify-center text-secondary"><span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">verified</span></div>
            </div>
            <div class="mt-2">
                <div class="font-headline-md text-headline-md text-on-surface tracking-tight">@Inventory.ActiveSkuCount SKUs</div>
                <div class="text-on-surface-variant font-label-sm text-label-sm mt-1 truncate">@Inventory.CurrentCompany.Name</div>
            </div>
        </div>
        <div class="bg-surface-container-lowest p-3.5 rounded-xl shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Stock Valuation</span>
                <div class="w-7 h-7 rounded-lg bg-surface-container-high flex items-center justify-center text-tertiary"><span class="material-symbols-outlined text-[18px]">payments</span></div>
            </div>
            <div class="mt-2">
                <div class="font-headline-md text-headline-md text-on-surface tracking-tight text-[19px] leading-tight">@Inventory.CurrentCompany.CurrencySymbol @Inventory.TotalValuation.ToString("N0")</div>
                <div class="flex items-center gap-1 mt-1 text-[#065F46] font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
                    <span class="font-semibold">Active Inventory</span>
                </div>
            </div>
        </div>
        <div class="bg-surface-container-lowest p-3.5 rounded-xl shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Stockout Risk</span>
                <div class="w-7 h-7 rounded-lg bg-tertiary-fixed/30 flex items-center justify-center text-tertiary"><span class="material-symbols-outlined text-[18px]">shield</span></div>
            </div>
            <div class="mt-2">
                <div class="flex items-center gap-1.5">
                    <span class="font-headline-md text-headline-md @(Inventory.OutOfStockCount > 0 ? "text-error" : "text-primary") tracking-tight">
                        @(Inventory.OutOfStockCount > 0 ? "Action Required" : "Optimal")
                    </span>
                </div>
                <div class="text-on-surface-variant font-label-sm text-label-sm mt-1">
                    @Inventory.OutOfStockCount SKUs out of stock
                </div>
            </div>
        </div>
    </div>

    <!-- Stock velocity -->
    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col gap-3">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">@Inventory.CurrentCompany.Code Movement Activity</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Inbound vs Outbound velocity</p>
            </div>
            <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm">
                <span class="font-semibold text-primary">@Inventory.InboundToday inbound</span> / <span class="font-semibold text-secondary">@Inventory.OutboundToday outbound</span>
            </div>
        </div>
        <div class="flex flex-col gap-2.5 pt-1">
            <div>
                <div class="flex justify-between items-center mb-1">
                    <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-primary-container"></span>Inbound Deliveries</span>
                    <span class="font-label-md text-label-md text-on-surface font-semibold">@(Inventory.InboundToday) shipments</span>
                </div>
                <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden"><div class="bg-primary-container h-full rounded-full transition-all duration-700" style="width: 58%;"></div></div>
            </div>
            <div>
                <div class="flex justify-between items-center mb-1">
                    <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-secondary"></span>Outbound Dispatched</span>
                    <span class="font-label-md text-label-md text-on-surface font-semibold">@(Inventory.OutboundToday) orders</span>
                </div>
                <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden"><div class="bg-secondary h-full rounded-full transition-all duration-700" style="width: 42%;"></div></div>
            </div>
        </div>
        <div class="pt-2">
            <div class="flex justify-between items-end h-20 px-1 gap-2">
                @foreach (var w in weeks)
                {
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end">
                        <div class="w-full flex items-end justify-center gap-1 h-14">
                            <div class="w-2.5 bg-primary-container/80 rounded-t-sm" style="height: @(w.In)%;"></div>
                            <div class="w-2.5 bg-secondary/80 rounded-t-sm" style="height: @(w.Out)%;"></div>
                        </div>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">@w.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Category breakdown (Computed dynamically from current company products) -->
    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col gap-3">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Category Breakdown</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Valuation distribution for @Inventory.CurrentCompany.Name</p>
            </div>
            <a href="/inventory" class="text-secondary font-label-md text-label-md flex items-center">Catalog <span class="material-symbols-outlined text-[16px]">chevron_right</span></a>
        </div>
        <div class="w-full h-3.5 rounded-full overflow-hidden flex shadow-inner">
            @foreach (var c in CategoryList)
            {
                <div class="h-full" style="width: @(c.Percent)%; background-color: @c.Color;" title="@c.Name @c.Percent%"></div>
            }
        </div>
        <div class="flex flex-col gap-2 pt-1">
            @foreach (var c in CategoryList)
            {
                <div class="flex items-center justify-between py-1">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full" style="background-color: @c.Color;"></span>
                        <span class="font-body-md text-body-md text-on-surface">@c.Name</span>
                    </div>
                    <div class="text-right">
                        <span class="font-label-md text-label-md text-on-surface font-semibold">@c.Value</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant ml-1">@c.Percent%</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Tenant intelligence / Reorder advice -->
    <div class="flex flex-col gap-space-sm">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 1;">psychology</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">@Inventory.CurrentCompany.Code Stock Advisor</h3>
            </div>
            <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold">1 Action</span>
        </div>

        @{
            var targetReorder = Inventory.NeedsReorder.FirstOrDefault() ?? Inventory.Products.FirstOrDefault();
        }

        @if (targetReorder is not null && !poDismissed)
        {
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col gap-2.5">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-[18px]">warning</span></div>
                    <div>
                        <div class="font-label-md text-label-md text-on-surface font-bold">@targetReorder.Sku • @targetReorder.Name</div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-label-sm text-label-sm font-semibold">Current Stock: @targetReorder.OnHand (Min @targetReorder.MinLevel)</span>
                    </div>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Replenishment recommendation: order <strong class="text-on-surface font-medium">@(Math.Max(50, targetReorder.MinLevel * 2)) units</strong> via @targetReorder.Supplier for @Session.HubName.
                </p>
                <div class="pt-1 flex items-center gap-2">
                    <button @onclick="ApprovePoAsync" disabled="@(poState != PoState.Idle)"
                            class="flex-1 h-10 px-4 rounded-lg font-label-lg text-label-lg flex items-center justify-center gap-1.5 shadow-sm active:scale-95 transition-transform @(poState == PoState.Approved ? "bg-primary-container text-on-primary-container" : "bg-gradient-to-r from-primary to-secondary text-on-primary")">
                        <span class="material-symbols-outlined text-[18px] @(poState == PoState.Processing ? "animate-spin" : null)">@(poState switch { PoState.Processing => "refresh", PoState.Approved => "check_circle", _ => "bolt" })</span>
                        <span>@(poState switch { PoState.Processing => "Placing Order...", PoState.Approved => "PO Approved #PO-9921", _ => $"Authorize PO ({Inventory.CurrentCompany.CurrencySymbol} {(targetReorder.UnitCost * 50):N0})" })</span>
                    </button>
                    @if (poState != PoState.Approved)
                    {
                        <button aria-label="Dismiss alert" @onclick="() => poDismissed = true"
                                class="w-10 h-10 rounded-lg bg-surface-container text-on-surface-variant flex items-center justify-center active:scale-95 transition-transform">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Export -->
    <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-[0_1px_3px_rgba(15,23,42,0.05)] flex flex-col gap-space-sm mb-2">
        <h3 class="font-headline-sm text-headline-sm text-on-surface">Export @Inventory.CurrentCompany.Code Reports</h3>
        <div class="grid grid-cols-3 gap-2">
            <button @onclick="ExportPdfAsync" class="flex flex-col items-center justify-center p-2.5 rounded-lg bg-surface-container active:scale-95 transition-all text-on-surface gap-1.5">
                <span class="material-symbols-outlined text-[22px] text-primary">picture_as_pdf</span>
                <span class="font-label-sm text-label-sm text-center font-medium leading-tight">PDF Summary</span>
            </button>
            <button @onclick="ExportCsvAsync" class="flex flex-col items-center justify-center p-2.5 rounded-lg bg-surface-container active:scale-95 transition-all text-on-surface gap-1.5">
                <span class="material-symbols-outlined text-[22px] text-secondary">table_view</span>
                <span class="font-label-sm text-label-sm text-center font-medium leading-tight">CSV Ledger</span>
            </button>
            <a href="/stock-audit" class="flex flex-col items-center justify-center p-2.5 rounded-lg bg-surface-container active:scale-95 transition-all text-on-surface gap-1.5">
                <span class="material-symbols-outlined text-[22px] text-tertiary">schedule_send</span>
                <span class="font-label-sm text-label-sm text-center font-medium leading-tight">Auto-Audit</span>
            </a>
        </div>
    </div>
</div>

@code {
    enum PoState { Idle, Processing, Approved }

    record Week(string Label, int In, int Out);
    record Category(string Name, string Value, int Percent, string Color);

    static readonly string[] ranges = { "Today", "Last 7 Days", "30 Days", "Quarter" };

    static readonly Week[] weeks =
    {
        new("W1", 60, 52), new("W2", 80, 70), new("W3", 95, 88), new("W4", 75, 64),
    };

    static readonly string[] colors = { "#0060ab", "#05b19a", "#67abff", "#f59e0b", "#a3c9ff" };

    string range = "30 Days";
    PoState poState = PoState.Idle;
    bool poDismissed;

    static string Csv(string? value) => "\"" + (value ?? "").Replace("\"", "\"\"") + "\"";

    async Task ExportCsvAsync()
    {
        var rows = new List<string> { "Record type,Date,SKU,Item,Warehouse,Movement,On hand,Unit cost,Value,Notes" };
        rows.AddRange(Inventory.Products.Select(p => string.Join(",", new[] { Csv("Stock"), Csv(DateTime.Now.ToString("yyyy-MM-dd")), Csv(p.Sku), Csv(p.Name), Csv(p.Warehouse), Csv(""), Csv(p.OnHand.ToString()), Csv(p.UnitCost.ToString("0.00")), Csv(p.Valuation.ToString("0.00")), Csv(p.SupplierNote) })));
        rows.AddRange(Inventory.Movements.Where(m => m.CompanyId == Inventory.CurrentCompanyId).OrderByDescending(m => m.At).Select(m => string.Join(",", new[] { Csv(m.Kind.ToString()), Csv(m.At.ToString("yyyy-MM-dd HH:mm")), Csv(m.Sku), Csv(m.Title), Csv(Session.HubName), Csv(m.Delta.ToString()), Csv(""), Csv(""), Csv(""), Csv(m.Subtitle) })));
        await JS.InvokeVoidAsync("solvixExports.download", $"{Inventory.CurrentCompany.Code}-stock-ledger-{DateTime.Now:yyyyMMdd}.csv", "\uFEFF" + string.Join("\r\n", rows), "text/csv;charset=utf-8");
    }

    async Task ExportPdfAsync()
    {
        static string H(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
        var productRows = string.Join("", Inventory.Products.OrderBy(p => p.Name).Select(p => $"<tr><td>{H(p.Sku)}</td><td>{H(p.Name)}</td><td>{H(p.Warehouse)}</td><td>{p.OnHand:N0}</td><td>{H(p.Status.ToString())}</td><td>{Inventory.CurrentCompany.CurrencySymbol}{p.Valuation:N2}</td></tr>"));
        var html = $"<!doctype html><html><head><meta charset='utf-8'><title>{H(Inventory.CurrentCompany.Name)} stock summary</title><style>body{{font:12px Arial,sans-serif;color:#1b2b3b;margin:32px}}h1{{margin-bottom:4px}}.muted{{color:#68798a}}.stats{{display:flex;gap:26px;margin:24px 0;padding:16px;background:#f1f6f7}}.stats b{{display:block;font-size:20px;margin-top:5px}}table{{border-collapse:collapse;width:100%;font-size:10px}}th,td{{text-align:left;padding:9px 7px;border-bottom:1px solid #dce5e9}}th{{background:#eef4f5}}footer{{margin-top:28px;color:#718091}}</style></head><body><h1>{H(Inventory.CurrentCompany.Name)} · Stock Summary</h1><div class='muted'>{H(Inventory.CurrentCompany.Code)} · Generated {DateTime.Now:dd MMM yyyy HH:mm} · {H(Session.HubName)}</div><div class='stats'><span>Catalog SKUs<b>{Inventory.Products.Count}</b></span><span>Total units<b>{Inventory.Products.Sum(p => p.OnHand):N0}</b></span><span>Stock valuation<b>{H(Inventory.CurrentCompany.CurrencySymbol)}{Inventory.TotalValuation:N2}</b></span><span>Needs attention<b>{Inventory.Products.Count(p => p.Status != StockStatus.Optimal)}</b></span></div><h2>Stock by SKU</h2><table><thead><tr><th>SKU</th><th>Product</th><th>Warehouse</th><th>On hand</th><th>Status</th><th>Value</th></tr></thead><tbody>{productRows}</tbody></table><footer>Generated by Solvix SIMS · {H(Inventory.CurrentCompany.Name)}</footer></body></html>";
        await JS.InvokeVoidAsync("solvixExports.print", html);
    }

    List<Category> CategoryList
    {
        get
        {
            var totalVal = Inventory.TotalValuation;
            if (totalVal <= 0)
            {
                return new() { new("General Stock", $"{Inventory.CurrentCompany.CurrencySymbol} 0", 100, "#0060ab") };
            }

            var groups = Inventory.Products
                .GroupBy(p => string.IsNullOrWhiteSpace(p.Group) ? "General Inventory" : p.Group)
                .Select((g, i) =>
                {
                    var val = g.Sum(p => p.Valuation);
                    var pct = (int)Math.Max(5, Math.Round(val * 100m / totalVal));
                    return new Category(g.Key, $"{Inventory.CurrentCompany.CurrencySymbol} {val:N0}", pct, colors[i % colors.Length]);
                })
                .ToList();

            return groups;
        }
    }

    protected override void OnInitialized()
    {
        Inventory.Changed += OnChanged;
        Session.Changed += OnChanged;
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    async Task ApprovePoAsync()
    {
        poState = PoState.Processing;
        StateHasChanged();
        await Task.Delay(800);
        poState = PoState.Approved;
    }

    public void Dispose()
    {
        Inventory.Changed -= OnChanged;
        Session.Changed -= OnChanged;
    }
}
