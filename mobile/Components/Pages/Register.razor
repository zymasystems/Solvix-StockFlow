@page "/register"
@layout BlankLayout
@using Solvix.Sims.Services.Authentication
@inject MobileAuthCoordinator Auth

<main class="auth-page p-6 max-w-md mx-auto">
    <h1 class="text-2xl font-bold mb-3">Register for Solvix access</h1>
    <p class="mb-4">Your profile will need administrator approval before you can sign in.</p>
    <form class="flex flex-col gap-4" @onsubmit="RegisterAsync" @onsubmit:preventDefault="true">
        <label>First name<input class="w-full border rounded p-3" @bind="firstName" required maxlength="100" autocomplete="given-name" /></label>
        <label>Last name<input class="w-full border rounded p-3" @bind="lastName" required maxlength="100" autocomplete="family-name" /></label>
        <label>Company name<input class="w-full border rounded p-3" @bind="company" required maxlength="150" autocomplete="organization" /></label>
        <label>Email<input class="w-full border rounded p-3" type="email" @bind="email" required autocomplete="username" /></label>
        <label>Password<input class="w-full border rounded p-3" type="password" @bind="password" required autocomplete="new-password" /></label>
        <label>Confirm password<input class="w-full border rounded p-3" type="password" @bind="confirmation" required autocomplete="new-password" /></label>
        <label><input type="checkbox" @bind="accepted" required /> I accept my organisation's access terms.</label>
        @if (!string.IsNullOrEmpty(error)) { <p role="alert" class="text-error">@error</p> }
        @if (!string.IsNullOrEmpty(message)) { <p role="status">@message</p> }
        <button class="bg-primary text-on-primary rounded p-3" type="submit" disabled="@busy">@(busy ? "Creating account..." : "Create account")</button>
        <a class="text-primary underline" href="/login">Back to sign in</a>
    </form>
</main>

@code {
    string firstName = "", lastName = "", company = "", email = "", password = "", confirmation = "";
    bool accepted, busy;
    string? error, message;
    async Task RegisterAsync()
    {
        if (busy) return;
        error = null; message = null;
        if (password != confirmation) { error = "The passwords do not match."; return; }
        busy = true;
        try
        {
            await Auth.RegisterAsync(email, password, new RegisterProfileInput
            { FirstName = firstName.Trim(), LastName = lastName.Trim(), Company = company.Trim(), AcceptTerms = accepted });
            message = "Profile created. Ask your administrator to approve your account, then sign in.";
        }
        catch (Exception exception) { error = AuthMessages.Describe(exception); }
        finally { password = ""; confirmation = ""; busy = false; }
    }
}
