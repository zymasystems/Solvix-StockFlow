@page "/adjust/{Sku}"
@layout StackLayout
@inject InventoryService Inventory
@inject SessionState Session
@inject NavigationManager Nav

@if (product is null)
{
    <div class="flex flex-col items-center gap-2 py-space-xl text-center">
        <span class="material-symbols-outlined text-[36px] text-outline">search_off</span>
        <p class="font-body-md text-body-md text-on-surface-variant">No product found for <span class="font-mono">@Sku</span>.</p>
        <a href="/inventory" class="font-label-lg text-label-lg text-secondary">Back to inventory</a>
    </div>
}
else
{
    var p = product;
    <div class="flex flex-col w-full pb-8 space-y-space-md">

        <!-- Active item -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-md shadow-sm">
            <div class="flex items-start gap-space-md">
                <ProductThumb Product="p" Class="w-20 h-20">
                    <div class="absolute bottom-1 right-1 bg-inverse-surface/80 backdrop-blur-md rounded px-1 text-[10px] text-inverse-on-surface font-label-sm">@p.Zone.Replace("Zone ", "")</div>
                </ProductThumb>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5 mb-1">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                            ACTIVE LOT
                        </span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant truncate">Batch #@p.Batch</span>
                    </div>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface leading-tight truncate">@p.Name</h2>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="font-label-sm text-label-sm text-on-surface-variant tracking-wider uppercase bg-surface-container px-1.5 py-0.5 rounded">SKU: @p.Sku</span>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-space-sm mt-space-md bg-surface-container-low rounded-lg p-space-sm">
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Current Physical Stock</span>
                    <div class="flex items-baseline gap-1 mt-0.5">
                        <span class="font-metric-num text-metric-num text-on-surface">@p.OnHand</span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Units</span>
                    </div>
                </div>
                <div class="flex flex-col justify-center">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Assigned Bin</span>
                    <div class="flex items-center gap-1 mt-0.5 text-on-surface">
                        <span class="material-symbols-outlined text-[16px] text-primary">warehouse</span>
                        <span class="font-label-md text-label-md truncate">@p.Zone • @SafeBinPart(p, 1, p.Bin)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mode toggle -->
        <div class="bg-surface-container-lowest p-1.5 rounded-xl shadow-sm">
            <div class="grid grid-cols-2 gap-1.5" role="tablist">
                <button type="button" @onclick="() => SetMode(true)"
                        class="flex items-center justify-center gap-2 py-3 px-space-md rounded-lg font-label-lg text-label-lg transition-all active:scale-[0.98] @(isDeduct ? "bg-error-container text-on-error-container" : "text-on-surface-variant")">
                    <span class="material-symbols-outlined text-[20px]">remove_circle</span>
                    <span>Deduct Stock (-)</span>
                </button>
                <button type="button" @onclick="() => SetMode(false)"
                        class="flex items-center justify-center gap-2 py-3 px-space-md rounded-lg font-label-lg text-label-lg transition-all active:scale-[0.98] @(!isDeduct ? "bg-primary-container text-on-primary" : "text-on-surface-variant")">
                    <span class="material-symbols-outlined text-[20px]">add_circle</span>
                    <span>Add Stock (+)</span>
                </button>
            </div>
        </div>

        <!-- Stepper -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">
            <div class="flex items-center justify-between mb-space-sm">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Adjustment Quantity</span>
                <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-label-sm text-label-sm @(isDeduct ? "bg-error-container text-on-error-container" : "bg-primary-fixed text-on-primary-fixed")">
                    <span class="material-symbols-outlined text-[14px]">@(isDeduct ? "trending_down" : "trending_up")</span>
                    <span>@(isDeduct ? "Subtracting" : "Adding")</span>
                </div>
            </div>

            <div class="flex items-center justify-between gap-space-sm my-space-sm">
                <button type="button" aria-label="Decrease quantity" @onclick="() => Qty--"
                        class="w-16 h-16 rounded-xl bg-surface-container-high text-on-surface flex items-center justify-center active:scale-90 transition-transform shadow-sm">
                    <span class="material-symbols-outlined text-[32px]">remove</span>
                </button>
                <div class="flex-1 flex flex-col items-center justify-center px-space-sm py-2 bg-surface rounded-xl">
                    <input type="number" inputmode="numeric" min="1" max="999" value="@Qty" @onchange="OnQtyChanged"
                           class="w-full text-center font-headline-lg text-headline-lg font-bold bg-transparent border-0 text-on-surface focus:outline-none p-0" />
                    <span class="font-label-sm text-label-sm text-on-surface-variant mt-0.5">UNITS ADJUSTED</span>
                </div>
                <button type="button" aria-label="Increase quantity" @onclick="() => Qty++"
                        class="w-16 h-16 rounded-xl bg-surface-container-high text-on-surface flex items-center justify-center active:scale-90 transition-transform shadow-sm">
                    <span class="material-symbols-outlined text-[32px]">add</span>
                </button>
            </div>

            <div class="mt-space-md pt-space-sm flex items-center justify-between bg-surface-container-low rounded-lg p-space-md">
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Projected New Balance</span>
                    <div class="flex items-baseline gap-1.5 mt-0.5">
                        <span class="font-headline-md text-headline-md text-on-surface">@Projected</span>
                        <span class="font-body-md text-body-md text-on-surface-variant">Units</span>
                    </div>
                </div>
                <div class="flex items-center gap-1 px-3 py-1.5 rounded-full font-label-md text-label-md shadow-sm @(isDeduct ? "bg-error text-on-error" : "bg-primary-container text-on-primary")">
                    <span class="material-symbols-outlined text-[16px]">@(isDeduct ? "arrow_downward" : "arrow_upward")</span>
                    <span>@(isDeduct ? "-" : "+")@Qty Units</span>
                </div>
            </div>
            @if (isDeduct && Qty > p.OnHand)
            {
                <p class="font-body-sm text-body-sm text-amber-800 mt-space-sm flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">warning</span>
                    That is more than the @p.OnHand on hand. The balance will stop at 0.
                </p>
            }
        </div>

        <!-- Reason -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-sm">
            <div class="flex items-center justify-between">
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Adjustment Reason</h3>
                <span class="font-label-sm text-label-sm text-primary font-semibold">REQUIRED</span>
            </div>
            <div class="grid grid-cols-2 gap-space-sm">
                @foreach (var r in reasons)
                {
                    var sel = reason == r.Key;
                    <button type="button" @onclick="() => reason = r.Key"
                            class="text-left p-space-sm rounded-xl transition-all flex flex-col justify-between active:scale-[0.98] @(sel ? "bg-primary-container/15 text-on-primary-container" : "bg-surface-container-low text-on-surface")">
                        <div class="flex items-center justify-between w-full mb-2">
                            <span class="material-symbols-outlined text-[24px] @(sel ? "text-primary" : "text-on-surface-variant")">@r.Icon</span>
                            <span class="material-symbols-outlined text-[18px] @(sel ? "text-primary" : "text-outline-variant")"
                                  style="@(sel ? "font-variation-settings:'FILL' 1" : null)">@(sel ? "check_circle" : "radio_button_unchecked")</span>
                        </div>
                        <div>
                            <div class="font-label-lg text-label-lg font-bold">@r.Title</div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5 leading-snug">@r.Description</p>
                        </div>
                    </button>
                }
            </div>
        </div>

        <!-- Bin -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">
            <div class="flex items-center justify-between mb-space-sm">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary text-[22px]">hub</span>
                    <h3 class="font-label-lg text-label-lg text-on-surface">Target Bin Location</h3>
                </div>
                <button type="button" class="text-primary font-label-md text-label-md flex items-center gap-1 active:opacity-75">
                    <span>Change Bin</span>
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                </button>
            </div>
            <div class="flex items-center gap-space-sm p-space-sm bg-surface-container-low rounded-xl">
                <div class="w-12 h-12 rounded-lg bg-surface-container-highest flex items-center justify-center text-on-surface flex-shrink-0">
                    <span class="material-symbols-outlined text-[24px]">grid_goldenratio</span>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-label-md text-label-md text-on-surface truncate">@p.BinLong</div>
                    <div class="flex items-center gap-2 mt-0.5">
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Sub-Bin: #@(SafeBinPart(p, 2, p.Bin).Replace("Shelf ", ""))-NORTH</span>
                        <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
                        <span class="font-body-sm text-body-sm text-primary">Capacity @Capacity%</span>
                    </div>
                </div>
                <button type="button" aria-label="Scan bin barcode" class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant active:scale-95">
                    <span class="material-symbols-outlined text-[20px]">qr_code_scanner</span>
                </button>
            </div>
        </div>

        <!-- Evidence -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm space-y-space-md">
            <div class="flex items-center justify-between">
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Evidence &amp; Logs</h3>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Recommended for QA</span>
            </div>
            <div>
                <label class="block font-label-md text-label-md text-on-surface-variant mb-1.5">Visual Proof (Damage / Condition)</label>
                <div class="flex items-center gap-space-sm overflow-x-auto pb-1">
                    @* Camera capture is not wired yet. See README (MediaPicker.CapturePhotoAsync). *@
                    <button type="button" class="w-20 h-20 rounded-xl bg-surface-container-low flex flex-col items-center justify-center gap-1 text-primary active:scale-95 flex-shrink-0">
                        <span class="material-symbols-outlined text-[24px]">add_a_photo</span>
                        <span class="font-label-sm text-label-sm">Add File</span>
                    </button>
                </div>
            </div>
            <div>
                <label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="reference-id">Reference WO / PO Number</label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined text-outline absolute left-3.5 text-[20px] pointer-events-none">tag</span>
                    <input id="reference-id" type="text" @bind="reference" @bind:event="oninput" placeholder="e.g. PO-74921 or WO-8910"
                           class="w-full h-12 pl-11 pr-4 rounded-xl bg-surface-container-low text-on-surface font-label-lg text-label-lg placeholder:text-on-surface-variant/50 focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container" />
                </div>
            </div>
            <div>
                <label class="block font-label-md text-label-md text-on-surface-variant mb-1.5" for="adjustment-notes">Discrepancy Justification Notes</label>
                <textarea id="adjustment-notes" rows="3" @bind="notes" @bind:event="oninput"
                          placeholder="Provide context regarding the item status, handling damage, or discrepancy discovery..."
                          class="w-full p-3.5 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant/50 focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container resize-none"></textarea>
            </div>
        </div>

        <!-- Identity -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-space-sm">
                <div class="w-11 h-11 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-sm flex-shrink-0">@Session.Initials</div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <span class="font-label-lg text-label-lg text-on-surface">@Session.FullName</span>
                        <span class="material-symbols-outlined text-primary text-[16px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                    </div>
                    <div class="font-body-sm text-body-sm text-on-surface-variant">@Session.Role • @Session.Terminal</div>
                </div>
            </div>
            <div class="flex flex-col items-end">
                <span class="inline-flex items-center gap-1 font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed">
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></span>
                    SECURE LOG
                </span>
                <span class="font-label-sm text-label-sm text-on-surface-variant mt-1">Shift A-09</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="sticky bottom-0 pt-space-sm pb-safe bg-surface/90 backdrop-blur-md space-y-space-xs z-30">
            <button type="button" @onclick="ConfirmAsync" disabled="@(saving || saved)"
                    class="w-full h-12 rounded-lg text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-md active:scale-[0.98] transition-transform @(saved ? "bg-primary" : "bg-gradient-to-r from-primary-container to-secondary")">
                <span class="material-symbols-outlined text-[20px] @(saving ? "animate-spin" : null)">@(saved ? "check_circle" : saving ? "progress_activity" : "task_alt")</span>
                <span>@(saved ? "Adjustment Logged" : saving ? "Saving..." : "Confirm Stock Adjustment")</span>
            </button>
            <button type="button" @onclick="Discard" disabled="@(saving || saved)"
                    class="w-full h-11 rounded-lg bg-transparent text-on-surface-variant font-label-md text-label-md active:scale-[0.98] transition-all flex items-center justify-center">
                Discard &amp; Return
            </button>
        </div>
    </div>
}

@code {
    record Reason(string Key, string Title, string Description, string Icon);

    static readonly Reason[] reasons =
    {
        new("damaged", "Damaged", "Cracked, non-op, or degraded components", "broken_image"),
        new("discrepancy", "Lost / Shortfall", "Physical inventory missing vs database", "search_off"),
        new("received", "Received / Surplus", "Unlogged shipment arrival or found items", "unarchive"),
        new("audit", "Cycle Audit", "Routine scheduled count reconciliation", "fact_check"),
    };

    [Parameter] public string Sku { get; set; } = "";

    /// <summary>?mode=add opens in "Add Stock" mode (used by Receive / Add New SKU buttons).</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    Product? product;
    bool isDeduct = true;
    int qty = 1;
    string reason = "damaged";
    string? reference, notes;
    bool saving, saved;

    int Qty
    {
        get => qty;
        set => qty = Math.Clamp(value, 1, 999);
    }

    int Projected => product is null ? 0 : isDeduct ? Math.Max(0, product.OnHand - Qty) : product.OnHand + Qty;

    int Capacity => product is null || product.MaxCapacity == 0 ? 0 : (int)Math.Min(100, Projected * 100.0 / product.MaxCapacity);

    protected override void OnParametersSet()
    {
        product = Inventory.Find(Sku);
        if (string.Equals(Mode, "add", StringComparison.OrdinalIgnoreCase) && !saved)
        {
            isDeduct = false;
            reason = "received";
        }
    }

    void SetMode(bool deduct)
    {
        isDeduct = deduct;
        // Sensible default reason for each direction, only if the user has not chosen something else
        if (!deduct && reason == "damaged") reason = "received";
        if (deduct && reason == "received") reason = "damaged";
    }

    void OnQtyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) Qty = v;
        else Qty = 1;
    }

    async Task ConfirmAsync()
    {
        if (product is null) return;

        saving = true;
        StateHasChanged();
        await Task.Delay(400); // stand-in for an API round-trip

        var title = reasons.First(r => r.Key == reason).Title;
        Inventory.Adjust(product.Sku, isDeduct ? -Qty : Qty, title, reference, notes);

        saving = false;
        saved = true;
        StateHasChanged();
        await Task.Delay(700);
        Nav.NavigateTo($"/product/{product.Sku}");
    }

    void Discard() => Nav.NavigateTo($"/product/{Sku}");

    string SafeBinPart(Product prod, int index, string fallback)
    {
        var parts = prod.BinLong.Split(" • ", StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > index ? parts[index] : fallback;
    }
}
