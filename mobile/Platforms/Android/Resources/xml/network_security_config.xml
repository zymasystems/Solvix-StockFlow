<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Dev: allow cleartext HTTP to the local web API. The Android emulator reaches the host machine on 10.0.2.2.
      Replace these domains with the production API host and disable cleartext traffic for release builds.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
